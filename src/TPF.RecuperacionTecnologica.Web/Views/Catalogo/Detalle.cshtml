@model TPF.RecuperacionTecnologica.Web.ViewModels.Catalogo.EquipoCatalogoDetalleViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Detalle del equipo";

    var textoDemanda = Model.SolicitudesEnEspera switch
    {
        0 => "Nadie todavía",
        1 => "1 persona",
        var cantidad => $"{cantidad} personas"
    };
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Catálogo</a></li>
    <li aria-current="page">Detalle</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">@Model.MarcaYModelo</h1>
                <partial name="_EstadoEquipoBadge" model="EstadoEquipo.Disponible" />
            </div>
            <p class="page-sub page-sub-id"><partial name="_TipoEquipo" model="Model.TipoEquipo" /> · Equipo <span class="mono">@Model.CodigoEquipo</span></p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" asp-action="Index"><partial name="_Icon" model="@("arrow-left")" /><span>Volver al catálogo</span></a>
            <a class="btn btn-primary" asp-controller="Solicitudes" asp-action="Registrar" asp-route-nroEquipo="@Model.NroEquipo"><partial name="_Icon" model="@("tray")" /><span>Solicitar este equipo</span></a>
        </div>
    </div>

    <div class="g-detail">
        <section class="card" aria-label="Fotos del equipo">
            <div class="card-body">
                <partial name="_GaleriaEquipo" model="@((Model.Imagenes, Model.TipoEquipo, Model.Modelo, Model.MarcaYModelo))" />
            </div>
        </section>

        <div class="stack">
            <section class="card" aria-labelledby="titulo-resumen">
                <div class="card-header">
                    <div><h2 class="card-title" id="titulo-resumen">Resumen</h2></div>
                </div>
                <div class="card-body">
                    <dl class="dl">
                        <dt>Número de equipo</dt>
                        <dd><span class="mono">@Model.CodigoEquipo</span></dd>
                        <dt>Tipo</dt>
                        <dd><partial name="_TipoEquipo" model="Model.TipoEquipo" /></dd>
                        @if (Model.FechaDisponibilidad is not null)
                        {
                            <dt>Disponible desde</dt>
                            <dd>@Reloj.Fecha(Model.FechaDisponibilidad.Value)</dd>
                        }
                        <dt>Revisión técnica</dt>
                        <dd>
                            <partial name="_DictamenBadge" model="Model.DictamenTecnico" />
                            <span class="card-sub">evaluado el @Reloj.Fecha(Model.FechaRevision)</span>
                        </dd>
                        <dt>Personas que ya lo pidieron</dt>
                        <dd>@textoDemanda</dd>
                    </dl>
                </div>
            </section>

            <section class="card" aria-labelledby="titulo-caracteristicas">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="titulo-caracteristicas">Características técnicas</h2>
                        <p class="card-sub">Verificadas por el técnico en el diagnóstico</p>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.TieneEspecificaciones)
                    {
                        <dl class="dl">
                            @if (!string.IsNullOrWhiteSpace(Model.Procesador))
                            {
                                <dt>Procesador</dt>
                                <dd>@Model.Procesador</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.MemoriaRam))
                            {
                                <dt>Memoria RAM</dt>
                                <dd>@Model.MemoriaRam</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Almacenamiento))
                            {
                                <dt>Almacenamiento</dt>
                                <dd>@Model.Almacenamiento</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.TamanoPantalla))
                            {
                                <dt>Tamaño de pantalla</dt>
                                <dd>@Model.TamanoPantalla</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.EstadoBateria))
                            {
                                <dt>Estado de la batería</dt>
                                <dd>@Model.EstadoBateria</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Otros))
                            {
                                <dt>Otros datos</dt>
                                <dd>@Model.Otros</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="muted mb-0">Sin características técnicas registradas.</p>
                    }
                </div>
            </section>

            <section class="card" aria-labelledby="titulo-asignacion">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="titulo-asignacion">Cómo se asigna</h2>
                        <p class="card-sub">La solicitud se hace sobre este equipo</p>
                    </div>
                </div>
                <div class="card-body">
                    <p class="form-text mb-2">Si varias personas piden el mismo equipo, una persona coordinadora lo asigna en este orden:</p>
                    <partial name="_ReglaPrioridad" />
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/galeria-equipo.js" asp-append-version="true"></script>
}
