@model TPF.RecuperacionTecnologica.Web.ViewModels.Catalogo.CatalogoListadoViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Catálogo";

    string Nombre<T>(T valor) where T : struct, Enum =>
        Html.GetEnumSelectList<T>().First(i => i.Value == Convert.ToInt32(valor).ToString()).Text;
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Catálogo de equipos</h1></div>
            <p class="page-sub">Equipos revisados por un técnico y disponibles para solicitar</p>
        </div>
    </div>

    <section class="card" aria-label="Filtros del catálogo">
        <form class="filters" role="search" method="get" asp-action="Index" data-filtros-automaticos>
            <div class="filter">
                <label for="Tipo">Tipo de equipo</label>
                <div class="select">
                    <select asp-for="Tipo" class="form-select sm" asp-items="Html.GetEnumSelectList<TipoEquipo>()">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter" style="min-width:0">
                <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Filtrar</span></button>
            </div>
            <div class="filter" style="min-width:0">
                <a class="btn btn-ghost" asp-action="Index">Limpiar</a>
            </div>
        </form>

        @if (Model.HayFiltros && !Model.ErrorAlCargar)
        {
            <div class="filtros-activos" aria-label="Filtros aplicados">
                <span class="filtros-activos-total" role="status">@(Model.Filas.Count == 1 ? "1 resultado" : $"{Model.Filas.Count} resultados")</span>
                <span class="filtro-activo">
                    <span>Tipo: @Nombre(Model.Tipo!.Value)</span>
                    <a asp-action="Index" aria-label="Quitar el filtro de tipo de equipo"><partial name="_Icon" model="@("x")" /></a>
                </span>
            </div>
        }

        @if (Model.ErrorAlCargar)
        {
            <div class="card-body">
                <partial name="_ErrorCarga" model="@("Ocurrió un error al obtener los equipos disponibles. Intente nuevamente en unos minutos.")" />
            </div>
        }
        else if (Model.Filas.Count == 0 && Model.HayFiltros)
        {
            <div class="card-body">
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("filter")" /></span>
                    <h3>No hay equipos disponibles de este tipo</h3>
                    <p>Pruebe con otro tipo de equipo o quite el filtro.</p>
                    <a class="btn btn-secondary" asp-action="Index">Limpiar filtros</a>
                </div>
            </div>
        }
        else if (Model.Filas.Count == 0)
        {
            <div class="card-body">
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("laptop")" /></span>
                    <h3>Por ahora no hay equipos disponibles</h3>
                    <p>Cuando un equipo donado pase la revisión técnica aparecerá en este catálogo.</p>
                </div>
            </div>
        }
    </section>

    @if (!Model.ErrorAlCargar && Model.Filas.Count > 0)
    {
        <ul class="grid-3 list-unstyled m-0" aria-label="Equipos disponibles">
            @foreach (var equipo in Model.Filas)
            {
                <li class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(equipo.ImagenUrl))
                    {
                        <div class="ratio ratio-4x3">
                            <img src="@Url.Content(equipo.ImagenUrl)" class="object-fit-cover rounded-top" alt="Foto de @equipo.MarcaYModelo" loading="lazy" />
                        </div>
                    }
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">@equipo.MarcaYModelo</h2>
                            <p class="card-sub"><partial name="_TipoEquipo" model="equipo.TipoEquipo" /> · <span class="mono">@equipo.CodigoEquipo</span></p>
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column gap-3 flex-grow-1">
                        @if (equipo.TieneEspecificaciones)
                        {
                            <dl class="dl">
                                @if (!string.IsNullOrWhiteSpace(equipo.Procesador))
                                {
                                    <dt>Procesador</dt>
                                    <dd>@equipo.Procesador</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(equipo.MemoriaRam))
                                {
                                    <dt>Memoria RAM</dt>
                                    <dd>@equipo.MemoriaRam</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(equipo.Almacenamiento))
                                {
                                    <dt>Almacenamiento</dt>
                                    <dd>@equipo.Almacenamiento</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(equipo.TamanoPantalla))
                                {
                                    <dt>Tamaño de pantalla</dt>
                                    <dd>@equipo.TamanoPantalla</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(equipo.EstadoBateria))
                                {
                                    <dt>Estado de la batería</dt>
                                    <dd>@equipo.EstadoBateria</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(equipo.Otros))
                                {
                                    <dt>Otros datos</dt>
                                    <dd>@equipo.Otros</dd>
                                }
                            </dl>
                        }
                        else
                        {
                            <p class="muted">Sin características técnicas registradas.</p>
                        }
                        <div class="mt-auto">
                            <a class="btn btn-secondary" asp-action="Detalle" asp-route-id="@equipo.NroEquipo" aria-label="Ver detalle del equipo @equipo.MarcaYModelo"><partial name="_Icon" model="@("eye")" /><span>Ver detalle</span></a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script src="~/js/filtros-listado.js" asp-append-version="true"></script>
}
