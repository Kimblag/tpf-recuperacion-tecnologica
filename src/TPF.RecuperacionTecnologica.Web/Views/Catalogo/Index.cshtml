@model TPF.RecuperacionTecnologica.Web.ViewModels.Catalogo.CatalogoListadoViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Catalogo
@{
    ViewData["Title"] = "Catálogo";

    Func<int, string?> enlacePagina = pagina => Url.Action("Index", new
    {
        Busqueda = Model.Busqueda,
        Marca = Model.Marca,
        Tipo = Model.Tipo,
        Orden = Model.Orden,
        Pagina = pagina
    });

    string TextoDemanda(int cantidad) => cantidad switch
    {
        0 => "Sin solicitudes en espera",
        1 => "1 solicitud en espera",
        _ => $"{cantidad} solicitudes en espera"
    };

    var tipos = Enum.GetValues<TipoEquipo>();
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li aria-current="page">Catálogo</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Catálogo de equipos</h1></div>
            <p class="page-sub">Equipos disponibles para solicitar. Cada solicitud es sobre un equipo específico.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" asp-controller="Solicitudes" asp-action="Index"><partial name="_Icon" model="@("tray")" /><span>Mis solicitudes</span></a>
        </div>
    </div>

    <section class="stack" aria-label="Catálogo de equipos" data-listado data-tarjetas data-filas-carga="8">
        <div class="card">
            <form class="filters" role="search" method="get" asp-action="Index" data-filtros-automaticos>
                <input type="hidden" asp-for="Tipo" />
                <div class="filter grow">
                    <label for="Busqueda">Buscar</label>
                    <input asp-for="Busqueda" class="form-control sm" type="search" placeholder="Número, marca, modelo o característica" maxlength="60" data-filtro-texto />
                </div>
                <div class="filter">
                    <label for="Marca">Marca</label>
                    <div class="select">
                        <select asp-for="Marca" class="form-select sm" asp-items="@(new SelectList(Model.Marcas))">
                            <option value="">Todas</option>
                        </select>
                        <partial name="_Icon" model="@("chevron-down")" />
                    </div>
                </div>
                <div class="filter">
                    <label for="Orden">Ordenar por</label>
                    <div class="select">
                        <select asp-for="Orden" class="form-select sm" asp-items="Html.GetEnumSelectList<OrdenCatalogo>()"></select>
                        <partial name="_Icon" model="@("chevron-down")" />
                    </div>
                </div>
                <div class="filter" style="min-width:0">
                    <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Filtrar</span></button>
                </div>
                <div class="filter" style="min-width:0">
                    <a class="btn btn-ghost" asp-action="Index" data-muestra-carga>Limpiar</a>
                </div>
            </form>
            <div class="cat-tipos">
                <span class="form-label mb-2" id="cat-tipo-etiqueta">Tipo de equipo</span>
                <nav aria-labelledby="cat-tipo-etiqueta">
                    <ul class="chips list-unstyled m-0">
                        <li>
                            <a class="chip" asp-action="Index" asp-route-Busqueda="@Model.Busqueda" asp-route-Marca="@Model.Marca" asp-route-Orden="@Model.Orden" aria-current="@(Model.Tipo is null ? "true" : null)" data-muestra-carga>Todos</a>
                        </li>
                        @foreach (var tipo in tipos)
                        {
                            <li>
                                <a class="chip" asp-action="Index" asp-route-Busqueda="@Model.Busqueda" asp-route-Marca="@Model.Marca" asp-route-Orden="@Model.Orden" asp-route-Tipo="@tipo" aria-current="@(Model.Tipo == tipo ? "true" : null)" data-muestra-carga><partial name="_TipoEquipo" model="tipo" /></a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.ErrorAlCargar)
            {
                <div class="card">
                    <div class="card-body">
                        <partial name="_ErrorCarga" model="@("Ocurrió un error al obtener los equipos disponibles. Se puede intentar de nuevo en unos minutos.")" />
                    </div>
                </div>
            }
            else if (Model.Filas.Count == 0 && Model.HayFiltros)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="state">
                            <span class="state-ic"><partial name="_Icon" model="@("filter")" /></span>
                            <h3>No hay equipos con esos filtros</h3>
                            <p>Probar con otro tipo, otra marca o una búsqueda más corta.</p>
                            <a class="btn btn-secondary" asp-action="Index" data-muestra-carga>Limpiar filtros</a>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Filas.Count == 0)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="state">
                            <span class="state-ic"><partial name="_Icon" model="@("laptop")" /></span>
                            <h3>No hay equipos disponibles por ahora</h3>
                            <p>Cuando se incorporen nuevos equipos aparecerán aquí. Se puede volver a consultar más tarde.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="cat-results" role="status"><b>@Model.Total</b> de @Model.TotalDisponibles equipos disponibles</p>

                <h2 class="visually-hidden">Equipos disponibles</h2>
                <ul class="cat-grid">
                    @foreach (var equipo in Model.Filas)
                    {
                        var caracteristicas = new[] { equipo.Procesador, equipo.MemoriaRam, equipo.Almacenamiento, equipo.TamanoPantalla, equipo.EstadoBateria }
                            .Where(texto => !string.IsNullOrWhiteSpace(texto))
                            .Take(4)
                            .ToList();

                        <li class="eq-card">
                            <a class="eq-media" asp-action="Detalle" asp-route-id="@equipo.NroEquipo" tabindex="-1" aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(equipo.ImagenUrl))
                                {
                                    <img src="@Url.Content(equipo.ImagenUrl)" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="eq-ilustracion"><partial name="_IlustracionEquipo" model="@((equipo.TipoEquipo, equipo.Modelo))" /></span>
                                }
                                <span class="eq-type"><partial name="_TipoEquipo" model="equipo.TipoEquipo" /></span>
                                @if (equipo.CantidadImagenes > 0)
                                {
                                    <span class="eq-photos"><partial name="_Icon" model="@("image")" />@equipo.CantidadImagenes</span>
                                }
                            </a>
                            <div class="eq-body">
                                <div class="eq-top">
                                    <span class="mono">@equipo.CodigoEquipo</span>
                                    @if (equipo.FechaDisponibilidad is not null)
                                    {
                                        <span class="card-sub">Desde @equipo.FechaDisponibilidad.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                                <h3 class="eq-title"><a asp-action="Detalle" asp-route-id="@equipo.NroEquipo">@equipo.MarcaYModelo</a></h3>
                                @if (caracteristicas.Count > 0)
                                {
                                    <ul class="eq-specs">
                                        @foreach (var caracteristica in caracteristicas)
                                        {
                                            <li>@caracteristica</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="card-sub mb-0">Sin características registradas</p>
                                }
                                <p class="eq-demand"><partial name="_Icon" model="@("users")" /><span>@TextoDemanda(equipo.SolicitudesEnEspera)</span></p>
                            </div>
                            <div class="eq-foot">
                                <a class="btn btn-secondary" asp-action="Detalle" asp-route-id="@equipo.NroEquipo" aria-label="Ver detalle de @equipo.MarcaYModelo">Ver detalle</a>
                                <a class="btn btn-primary" asp-controller="Solicitudes" asp-action="Registrar" asp-route-nroEquipo="@equipo.NroEquipo" aria-label="Solicitar @equipo.MarcaYModelo">Solicitar</a>
                            </div>
                        </li>
                    }
                </ul>

                <div class="card mt-3">
                    <partial name="_Paginador" model="@((Model.Pagina, Model.TotalPaginas, Model.Desde, Model.Hasta, Model.Total, enlacePagina))" />
                </div>
            }
        </div>

        <template data-plantilla-carga>
            <div class="load-note" role="status"><partial name="_Icon" model="@("clock")" /><span>Cargando equipos…</span></div>
        </template>
    </section>
</div>

@section Scripts {
    <script src="~/js/filtros-listado.js" asp-append-version="true"></script>
    <script src="~/js/listado-carga.js" asp-append-version="true"></script>
}
