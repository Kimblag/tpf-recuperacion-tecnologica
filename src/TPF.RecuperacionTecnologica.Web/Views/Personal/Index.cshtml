@model TPF.RecuperacionTecnologica.Web.ViewModels.Personal.PersonalListadoViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Personal";

    Func<int, string?> enlacePagina = pagina => Url.Action("Index", new
    {
        Busqueda = Model.Busqueda,
        Rol = Model.Rol,
        Estado = Model.Estado,
        Acceso = Model.Acceso,
        Orden = Model.Orden,
        Pagina = pagina
    });
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li aria-current="page">Personal</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Personal</h1></div>
            <p class="page-sub">Personal interno con acceso a la plataforma</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" asp-action="Alta"><partial name="_Icon" model="@("plus")" /><span>Alta de personal</span></a>
        </div>
    </div>

    @if (Model.FiltroInvalido)
    {
        <div class="alert alert-warning" role="status">
            <partial name="_Icon" model="@("alert")" />
            <div class="alert-body">Alguno de los filtros indicados no es válido y se ignoró.</div>
        </div>
    }

    <section class="card overflow" aria-label="Personal">
        <form class="filters" role="search" method="get" asp-action="Index">
            <input type="hidden" asp-for="Orden" />
            <div class="filter grow">
                <label for="Busqueda">Buscar</label>
                <input asp-for="Busqueda" class="form-control sm" placeholder="Nombre, código o DNI" maxlength="60" />
            </div>
            <div class="filter">
                <label for="Rol">Rol</label>
                <div class="select">
                    <select asp-for="Rol" class="form-select sm" asp-items="Html.GetEnumSelectList<RolPersonal>().OrderByDescending(i => i.Value)">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter">
                <label for="Estado">Estado</label>
                <div class="select">
                    <select asp-for="Estado" class="form-select sm" asp-items="Html.GetEnumSelectList<EstadoPersonal>()">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter">
                <label for="Acceso">Acceso</label>
                <div class="select">
                    <select id="Acceso" name="acceso" class="form-select sm">
                        <option value="">Todos</option>
                        <option value="bloqueadas" selected="@(Model.Acceso == "bloqueadas")">Bloqueadas</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter" style="min-width:0">
                <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Filtrar</span></button>
            </div>
            <div class="filter" style="min-width:0">
                <a class="btn btn-ghost" asp-action="Index">Limpiar</a>
            </div>
        </form>

        <div class="card-body flush">
            @if (Model.Filas.Count == 0 && !Model.HayPersonal)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("idcard")" /></span>
                    <h3>No hay personal cargado</h3>
                    <p>Registrá al primer integrante del personal.</p>
                    <a class="btn btn-primary" asp-action="Alta"><partial name="_Icon" model="@("plus")" /><span>Alta de personal</span></a>
                </div>
            }
            else if (Model.Filas.Count == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("idcard")" /></span>
                    <h3>No se encontró personal con esos filtros</h3>
                    <p>Probá con otra búsqueda.</p>
                    <a class="btn btn-secondary" asp-action="Index">Limpiar</a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-stack">
                        <caption class="visually-hidden">Personal</caption>
                        <thead>
                            <tr>
                                <partial name="_EncabezadoOrden" model="@(("Código", "codigo", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Nombre y apellido", "nombre", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("DNI", "dni", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Correo", "correo", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Rol", "rol", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Estado", "estado", Model.Orden, false))" />
                                <th scope="col" class="col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in Model.Filas)
                            {
                                <tr>
                                    <td data-label="Código"><a class="mono" asp-action="Detalle" asp-route-id="@fila.CodigoPersonal">@fila.Codigo</a></td>
                                    <td data-label="Nombre y apellido">@fila.NombreCompleto @if (fila.EsRaiz) { <span class="tag">Principal</span> }</td>
                                    <td data-label="DNI"><span class="mono">@fila.DniFormateado</span></td>
                                    <td data-label="Correo"><span class="muted">@fila.CorreoElectronico</span></td>
                                    <td data-label="Rol">@Html.DisplayFor(m => fila.RolAsignado)</td>
                                    <td data-label="Estado"><partial name="_EstadoPersonalBadge" model="fila.EstadoPersonal" />@if (fila.EstaBloqueada) { <partial name="_Badge" model='@(("Bloqueada", "warn"))' /> }</td>
                                    <td class="col-actions" data-label="Acciones">
                                        <a class="btn btn-ghost btn-sm" asp-action="Detalle" asp-route-id="@fila.CodigoPersonal" aria-label="Ver @fila.Codigo"><partial name="_Icon" model="@("eye")" /><span>Ver</span></a>
                                        @if (!fila.EsRaiz && fila.CodigoPersonal != Model.CodigoActual)
                                        {
                                            <a class="btn btn-ghost btn-sm btn-icon" asp-action="Editar" asp-route-id="@fila.CodigoPersonal" aria-label="Editar @fila.Codigo"><partial name="_Icon" model="@("edit")" /></a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <partial name="_Paginador" model="@((Model.Pagina, Model.TotalPaginas, Model.Desde, Model.Hasta, Model.Total, enlacePagina))" />
            }
        </div>
    </section>
</div>
