@model TPF.RecuperacionTecnologica.Web.ViewModels.Personal.EdicionPersonalViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Editar personal";
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li><a asp-action="Index">Personal</a></li>
    <li aria-current="page">Editar</li>
}

<div class="stack narrow">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">Editar personal</h1>
                <partial name="_EstadoPersonalBadge" model="Model.EstadoPersonal" />
            </div>
            <p class="page-sub">@Model.NombreCompleto · @Model.Codigo</p>
        </div>
    </div>

    @if (Model.EsRaiz)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body"><div>Este es el Administrador principal. Su rol y su correo no se pueden cambiar. El nombre y el teléfono sí se pueden actualizar.</div></div>
        </div>
    }

    <form class="card" asp-action="Editar" method="post" id="f-personal-editar" novalidate aria-labelledby="f-personal-titulo">
        <input type="hidden" asp-for="CodigoPersonal" />
        <input type="hidden" asp-for="EsRaiz" />
        <div class="card-header">
            <div><h2 class="card-title" id="f-personal-titulo">Datos del personal</h2></div>
        </div>
        <div class="card-body">
            <div class="stack" style="gap:16px">
                <partial name="_ResumenErrores" />

                <p class="form-note"><span class="req" aria-hidden="true">*</span> Campo obligatorio</p>

                <div class="form-grid">
                    <h3 class="span-2 sec-title">Datos de personal</h3>

                    <div class="field">
                        <label class="form-label" for="Dni">DNI <span class="lock muted"><partial name="_Icon" model="@("lock")" /><span class="visually-hidden">campo no editable</span></span></label>
                        <input asp-for="Dni" class="form-control" readonly />
                    </div>
                    <div class="field">
                        <label class="form-label" for="CodigoVisible">Código de personal</label>
                        <input id="CodigoVisible" class="form-control" value="@Model.Codigo" disabled aria-describedby="CodigoPersonal-hint" />
                        <div class="form-text" id="CodigoPersonal-hint">Identificador técnico usado en diagnósticos y auditoría.</div>
                    </div>
                    <div class="field">
                        <label class="form-label" for="Nombre">Nombre<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                        <input asp-for="Nombre" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Nombre"></span>
                    </div>
                    <div class="field">
                        <label class="form-label" for="Apellido">Apellido<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                        <input asp-for="Apellido" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="Apellido"></span>
                    </div>
                    <div class="field">
                        <label class="form-label" for="Telefono">Teléfono</label>
                        <input asp-for="Telefono" type="tel" class="form-control" autocomplete="tel" inputmode="tel" placeholder="11 5555-0000" />
                        <span asp-validation-for="Telefono"></span>
                    </div>
                    @if (Model.EsRaiz)
                    {
                        <div class="field">
                            <label class="form-label" for="RolVisible">Rol <span class="lock muted"><partial name="_Icon" model="@("lock")" /><span class="visually-hidden">campo no editable</span></span></label>
                            <input id="RolVisible" class="form-control" value="@Model.RolAsignado" readonly />
                            <input type="hidden" asp-for="RolAsignado" />
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label class="form-label" for="RolAsignado">Rol<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                            <div class="select">
                                <select asp-for="RolAsignado" class="form-select" asp-items="Html.GetEnumSelectList<RolPersonal>().OrderByDescending(i => i.Value)"></select>
                                <partial name="_Icon" model="@("chevron-down")" />
                            </div>
                            <span asp-validation-for="RolAsignado"></span>
                        </div>
                    }

                    <h3 class="span-2 sec-title">Cuenta de acceso</h3>

                    @if (Model.EsRaiz)
                    {
                        <div class="field span-2">
                            <label class="form-label" for="CorreoElectronico">Correo electrónico <span class="lock muted"><partial name="_Icon" model="@("lock")" /><span class="visually-hidden">campo no editable</span></span></label>
                            <input asp-for="CorreoElectronico" class="form-control" readonly />
                        </div>
                    }
                    else
                    {
                        <div class="field span-2">
                            <label class="form-label" for="CorreoElectronico">Correo electrónico<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                            <input asp-for="CorreoElectronico" class="form-control" autocomplete="off" />
                            <span asp-validation-for="CorreoElectronico"></span>
                        </div>
                    }
                    <div class="field">
                        <label class="form-label" for="EstadoVisible">Estado</label>
                        <input id="EstadoVisible" class="form-control" value="@(Model.EstadoPersonal == EstadoPersonal.Activo ? "Activo" : "Inactivo")" disabled />
                    </div>
                </div>
            </div>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary btn-lg" asp-action="Detalle" asp-route-id="@Model.CodigoPersonal">Cancelar</a>
            <button type="submit" class="btn btn-primary btn-lg">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var resumen = document.getElementById('resumen-errores');
        if (resumen) resumen.focus();
    </script>
}
