@model TPF.RecuperacionTecnologica.Web.ViewModels.Personal.PersonalDetalleViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Personal
@{
    ViewData["Title"] = "Detalle de personal";

    var estaActivo = Model.EstadoPersonal == EstadoPersonal.Activo;
    var puedeInactivar = !Model.EsRaiz && !Model.EsCuentaPropia;
    var erroresGenerales = ViewData.ModelState.TryGetValue(string.Empty, out var entrada) ? entrada.Errors : null;
    var hayErrorEnModal = ViewData.ModelState.TryGetValue("MotivoInactivacion", out var motivo) && motivo.Errors.Count > 0;
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li><a asp-action="Index">Personal</a></li>
    <li aria-current="page">Detalle</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">@Model.NombreCompleto</h1>
                <partial name="_EstadoPersonalBadge" model="Model.EstadoPersonal" />
            </div>
            <p class="page-sub page-sub-id">@Html.DisplayFor(m => m.RolAsignado) · Código @Model.Codigo</p>
        </div>
        <div class="page-actions">
            @if (Model.EsRaiz)
            {
                <button type="button" class="btn btn-secondary" disabled><partial name="_Icon" model="@("edit")" /><span>Editar personal</span></button>
            }
            else
            {
                <a class="btn btn-secondary" asp-action="Editar" asp-route-id="@Model.CodigoPersonal"><partial name="_Icon" model="@("edit")" /><span>Editar personal</span></a>
            }
            @if (puedeInactivar)
            {
                if (estaActivo)
                {
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-inactivar"><partial name="_Icon" model="@("ban")" /><span>Inactivar</span></button>
                }
                else
                {
                    <form asp-action="Reactivar" asp-route-id="@Model.CodigoPersonal" method="post">
                        <button type="submit" class="btn btn-primary"><partial name="_Icon" model="@("refresh")" /><span>Reactivar</span></button>
                    </form>
                }
            }
        </div>
    </div>

    @if (erroresGenerales is { Count: > 0 })
    {
        <div class="alert alert-danger" role="alert" tabindex="-1" id="resumen-errores">
            <partial name="_Icon" model="@("x-circle")" />
            <div class="alert-body">
                @foreach (var error in erroresGenerales)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }

    @if (Model.EsRaiz)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body"><div>Este es el Administrador principal. No se puede editar ni inactivar.</div></div>
        </div>
    }

    @if (Model.EsCuentaPropia && !Model.EsRaiz)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body"><div>Esta es la cuenta con la que se inició sesión. No se puede inactivar a sí misma: otro Administrador debe hacerlo.</div></div>
        </div>
    }

    @if (!estaActivo)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body"><div>Este personal está inactivo y no puede iniciar sesión. Sus registros históricos se conservan y se puede reactivar desde acá.</div></div>
        </div>
    }

    <section class="card">
        <div class="card-header">
            <div><h2 class="card-title">Datos de personal</h2></div>
        </div>
        <div class="card-body">
            <dl class="dl">
                <dt>DNI</dt>
                <dd><span class="mono">@Model.DniFormateado</span></dd>
                <dt>Teléfono</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</dd>
                <dt>Correo de acceso</dt>
                <dd>@Model.CorreoElectronico</dd>
            </dl>
        </div>
    </section>

    <section class="card overflow" aria-labelledby="titulo-actividad">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="titulo-actividad">Actividad reciente</h2>
                <p class="card-sub">@(Model.TotalActividad == 0 ? "Todavía no registró operaciones" : Model.TotalActividad > Model.Actividad.Count ? $"Últimas {Model.Actividad.Count} de {Model.TotalActividad} operaciones registradas" : Model.TotalActividad == 1 ? "1 operación registrada" : $"{Model.TotalActividad} operaciones registradas")</p>
            </div>
            @if (Model.TotalActividad > Model.Actividad.Count)
            {
                <a class="btn btn-secondary btn-sm" asp-controller="Auditoria" asp-action="Index" asp-route-CodigoPersonal="@Model.Codigo"><partial name="_Icon" model="@("history")" /><span>Ver toda la actividad</span></a>
            }
        </div>
        <div class="card-body flush">
            @if (Model.Actividad.Count == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("history")" /></span>
                    <h3>Sin actividad registrada</h3>
                    <p>Las operaciones que realice en la plataforma aparecerán acá.</p>
                </div>
            }
            else
            {
                <partial name="_TablaAuditoria" model="Model.Actividad" view-data='new ViewDataDictionary(ViewData) { ["OcultarPersonal"] = true }' />
            }
        </div>
    </section>
</div>

@if (estaActivo && puedeInactivar)
{
    <partial name="_ModalInactivar" model="new InactivarPersonalViewModel { CodigoPersonal = Model.CodigoPersonal, NombreCompleto = Model.NombreCompleto, Codigo = Model.Codigo }" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (hayErrorEnModal)
    {
        <script>
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-inactivar')).show();
        </script>
    }
}
