@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var esInicio = controlador == "Home" && accion == "Index";
    var esDonaciones = controlador == "Donaciones";
    var esCatalogo = controlador == "Catalogo";
    var esSolicitudes = controlador == "Solicitudes";
}
<nav id="sidebarNav" class="nav flex-column mb-auto" aria-label="Menú principal">
    <a class="nav-link d-flex align-items-center gap-2@(esInicio ? " active" : "")" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(esInicio ? "page" : null)">
        <span class="nav-dot"></span>
        <partial name="_Icon" model="@("grid")" />Inicio
    </a>
    <div class="nav-group" role="group" aria-labelledby="nav-grupo-donar">
        <div class="nav-heading" id="nav-grupo-donar">Donar</div>
        <a class="nav-link d-flex align-items-center gap-2@(esDonaciones ? " active" : "")" asp-area="" asp-controller="Donaciones" asp-action="Index" aria-current="@(esDonaciones ? "page" : null)">
            <span class="nav-dot"></span>
            <partial name="_Icon" model="@("gift")" />Mis donaciones
        </a>
    </div>
    <div class="nav-group" role="group" aria-labelledby="nav-grupo-solicitar">
        <div class="nav-heading" id="nav-grupo-solicitar">Solicitar equipos</div>
        <a class="nav-link d-flex align-items-center gap-2@(esCatalogo ? " active" : "")" asp-area="" asp-controller="Catalogo" asp-action="Index" aria-current="@(esCatalogo ? "page" : null)">
            <span class="nav-dot"></span>
            <partial name="_Icon" model="@("laptop")" />Catálogo
        </a>
        <a class="nav-link d-flex align-items-center gap-2@(esSolicitudes ? " active" : "")" asp-area="" asp-controller="Solicitudes" asp-action="Index" aria-current="@(esSolicitudes ? "page" : null)">
            <span class="nav-dot"></span>
            <partial name="_Icon" model="@("tray")" />Mis solicitudes
        </a>
    </div>
</nav>
