@* marca del producto (recicl.ar) con el nombre de la organización de Parámetros debajo *@
<div class="marca-app">
    <img class="marca-icono logo-claro" src="~/img/reciclar-icono-claro.svg" alt="" />
    <img class="marca-icono logo-oscuro" src="~/img/reciclar-icono-oscuro.svg" alt="" />
    <div class="marca-texto">
        <img class="marca-palabra logo-claro" src="~/img/reciclar-palabra-claro.svg" alt="recicl.ar" />
        <img class="marca-palabra logo-oscuro" src="~/img/reciclar-palabra-oscuro.svg" alt="recicl.ar" />
        <span class="marca-org">@ViewData["NombreOrganizacion"]</span>
    </div>
</div>
