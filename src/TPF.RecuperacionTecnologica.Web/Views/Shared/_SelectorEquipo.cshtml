@model TPF.RecuperacionTecnologica.Web.ViewModels.Compartido.SelectorEquipoViewModel
@using Microsoft.AspNetCore.Routing
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var valoresUsuario = (ViewData["ValoresRuta"] as IDictionary<string, string?> ?? new Dictionary<string, string?>())
        .Where(par => !string.IsNullOrEmpty(par.Value))
        .ToList();

    string Enlace(string? nroEquipo)
    {
        var ruta = new RouteValueDictionary();

        foreach (var par in valoresUsuario)
        {
            ruta[par.Key] = par.Value;
        }

        if (nroEquipo is not null)
        {
            ruta["nroEquipo"] = nroEquipo;
        }

        return Url.Action(accion, ruta)!;
    }
}

<div class="stack" style="gap:16px">
    @if (Model.Seleccionado is not null)
    {
        <div class="card" style="background-color: var(--app-surface-low)">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2" style="padding: 12px 16px">
                <div>
                    <div class="card-sub">Equipo seleccionado</div>
                    <div class="fw-semibold">@Model.Seleccionado.MarcaYModelo</div>
                    <div class="card-sub"><partial name="_TipoEquipo" model="Model.Seleccionado.TipoEquipo" /> · Nº <span class="mono">@Model.Seleccionado.CodigoEquipo</span></div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <partial name="_EstadoEquipoBadge" model="EstadoEquipo.Disponible" />
                    <a class="btn btn-secondary btn-sm" href="@Enlace(null)">Cambiar equipo</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <form method="get" action="@Url.Action(accion)" role="search" aria-label="Buscar equipo">
            @foreach (var par in valoresUsuario)
            {
                <input type="hidden" name="@par.Key" value="@par.Value" />
            }
            <label class="form-label" for="busquedaEquipo">Número, marca o modelo<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
            <div class="d-flex flex-wrap gap-2">
                <input id="busquedaEquipo" name="busquedaEquipo" value="@Model.Busqueda" class="form-control flex-grow-1" style="min-width:220px;width:auto" autocomplete="off" maxlength="60" aria-describedby="busquedaEquipo-ayuda" />
                <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Buscar</span></button>
            </div>
            <div class="form-text" id="busquedaEquipo-ayuda">Solo se ofrecen equipos Disponibles. Si hay muchos resultados, conviene afinar la búsqueda.</div>
        </form>

        @if (Model.BusquedaRealizada)
        {
            <div role="status">
                @if (Model.Resultados.Count == 0)
                {
                    <div class="alert alert-info">
                        <partial name="_Icon" model="@("info")" />
                        <div class="alert-body">
                            <div class="alert-title">No se encontró ningún equipo disponible</div>
                            <div>Revisar el dato ingresado o probar con otra marca o modelo.</div>
                        </div>
                    </div>
                }
                else
                {
                    <ul class="list-unstyled m-0 stack" style="gap:8px" aria-label="Resultados de la búsqueda">
                        @foreach (var equipo in Model.Resultados)
                        {
                            <li class="card">
                                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2" style="padding: 12px 16px">
                                    <div>
                                        <div class="fw-semibold">@equipo.MarcaYModelo</div>
                                        <div class="card-sub"><partial name="_TipoEquipo" model="equipo.TipoEquipo" /> · Nº <span class="mono">@equipo.CodigoEquipo</span></div>
                                    </div>
                                    <a class="btn btn-primary btn-sm" href="@Enlace(equipo.NroEquipo.ToString())" aria-label="Elegir @equipo.MarcaYModelo, número @equipo.CodigoEquipo">Elegir</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    }
</div>
