@model IReadOnlyList<TPF.RecuperacionTecnologica.Web.ViewModels.Auditoria.AuditoriaFilaViewModel>
@{
    // detalle interno de cada entidad; todas estas pantallas las puede ver el Administrador
    static (string Controlador, string Accion)? DestinoDe(string entidad) => entidad switch
    {
        "Solicitud" => ("Solicitudes", "DetalleInterno"),
        // un equipo lleva a su legajo (#127): historial completo, visible para el Administrador
        "Equipo" => ("Equipos", "Legajo"),
        "Asignacion" => ("Asignaciones", "Detalle"),
        "Entrega" => ("Entregas", "Detalle"),
        "Personal" => ("Personal", "Detalle"),
        _ => null
    };
}
<div class="table-wrap">
    <table class="table table-stack">
        <caption class="visually-hidden">Registro de auditoría</caption>
        <thead>
            <tr>
                <th scope="col">Fecha y hora</th>
                <th scope="col">Personal</th>
                <th scope="col">Operación</th>
                <th scope="col">Entidad</th>
                <th scope="col">Identificador</th>
                <th scope="col">Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in Model)
            {
                var destino = DestinoDe(fila.Entidad);

                <tr>
                    <td data-label="Fecha y hora"><span class="nowrap">@fila.FechaHora.ToString("dd/MM/yyyy HH:mm")</span></td>
                    <td data-label="Personal">@fila.Personal</td>
                    <td data-label="Operación"><span class="tag">@Html.DisplayFor(m => fila.Operacion)</span></td>
                    <td data-label="Entidad">@fila.EtiquetaEntidad</td>
                    <td data-label="Identificador">
                        @if (destino is not null)
                        {
                            <a class="mono" asp-controller="@destino.Value.Controlador" asp-action="@destino.Value.Accion" asp-route-id="@fila.IdEntidad">@fila.Identificador</a>
                        }
                        else
                        {
                            <span class="mono">@fila.Identificador</span>
                        }
                    </td>
                    <td data-label="Detalle"><span class="muted">@fila.Detalle</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
