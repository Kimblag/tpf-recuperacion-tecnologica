@model TPF.RecuperacionTecnologica.Web.ViewModels.Compartido.ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

@* Nunca se muestran detalles de la excepción: solo el tipo de error y un código de referencia para soporte *@

<div class="alert alert-danger" role="alert">
    <partial name="_Icon" model="@(Model.Codigo == 404 ? "alert" : "x-circle")" />
    <div class="alert-body">
        <div class="alert-title">@Model.Titulo</div>
        <div>@Model.Mensaje</div>
    </div>
</div>

<p class="mt-3"><a class="btn btn-primary" asp-controller="Home" asp-action="Index"><partial name="_Icon" model="@("arrow-left")" /><span>Volver al inicio</span></a></p>

@if (Model.ShowRequestId)
{
    <p class="form-text">Código de referencia: <span class="mono">@Model.RequestId</span></p>
}
