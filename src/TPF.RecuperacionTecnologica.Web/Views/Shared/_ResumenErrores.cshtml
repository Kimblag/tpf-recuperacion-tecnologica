@* Resumen de errores de validación del formulario actual. Lee el ModelState de la vista que lo incluye. *@
@{
    var secciones = ViewData["OrdenResumen"] as string[] ?? [];
    var propiedades = ViewData.ModelMetadata.Properties.ToList();

    (int Seccion, int Posicion) Orden(string clave)
    {
        var primera = clave.Split('.')[0];
        var seccion = Array.IndexOf(secciones, primera);

        return (seccion < 0 ? secciones.Length : seccion, propiedades.FindIndex(p => p.Name == primera));
    }

    var campos = ViewData.ModelState
        .Where(e => e.Value is { Errors.Count: > 0 })
        .OrderBy(e => string.IsNullOrEmpty(e.Key) ? (-1, 0) : Orden(e.Key))
        .ToList();
    var soloGenerales = campos.All(c => string.IsNullOrEmpty(c.Key));

    string NombreDelCampo(string clave)
    {
        var metadata = ViewData.ModelMetadata;

        foreach (var parte in clave.Split('.'))
        {
            var propiedad = metadata.Properties.FirstOrDefault(p => p.Name == parte);

            if (propiedad is null)
            {
                return clave;
            }

            metadata = propiedad;
        }

        return metadata.DisplayName ?? metadata.Name ?? clave;
    }
}
@if (campos.Count > 0)
{
    <div class="alert alert-danger" role="alert" tabindex="-1" id="resumen-errores">
        <partial name="_Icon" model="@("x-circle")" />
        <div class="alert-body">
            <div class="alert-title">@(soloGenerales ? "No se pudo completar la operación" : "Revisá los campos marcados")</div>
            <ul>
                @foreach (var campo in campos)
                {
                    if (string.IsNullOrEmpty(campo.Key))
                    {
                        <li>@campo.Value!.Errors[0].ErrorMessage</li>
                    }
                    else
                    {
                        <li><a href="#@Html.GenerateIdFromName(campo.Key)">@NombreDelCampo(campo.Key)</a></li>
                    }
                }
            </ul>
        </div>
    </div>
}
