@model TPF.RecuperacionTecnologica.Web.Models.Enums.EstadoEquipo
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    var texto = Model switch
    {
        EstadoEquipo.PendienteRecepcion => "Falta que lleve el equipo.",
        EstadoEquipo.EnReparacion => "Un técnico lo está arreglando.",
        EstadoEquipo.Disponible => "Listo para que otra persona lo pida.",
        EstadoEquipo.Asignado => "Una persona debe retirarlo.",
        EstadoEquipo.Entregado => "Ya se entregó.",
        EstadoEquipo.Baja => "No se pudo recuperar.",
        EstadoEquipo.Cancelado => "Usted canceló la donación.",
        _ => ""
    };
}
@if (!string.IsNullOrEmpty(texto))
{
    <span class="pista-estado">@texto</span>
}