@model TPF.RecuperacionTecnologica.Web.ViewModels.Entregas.RegistroEntregaViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Entregas
@{
    ViewData["Title"] = "Registrar entrega";
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Entregas</a></li>
    <li aria-current="page">Registrar entrega</li>
}

<div class="stack narrow">
    @if (Model.Situacion == SituacionEntrega.ElegirAsignacion)
    {
        <div class="page-head">
            <div>
                <div class="h-id"><h1 tabindex="-1">Registrar entrega</h1></div>
                <p class="page-sub">Elegir la asignación vigente cuyo equipo se está entregando</p>
            </div>
        </div>

        <section class="card" aria-labelledby="titulo-elegir">
            <div class="card-header">
                <div><h2 class="card-title" id="titulo-elegir">Asignación vigente</h2></div>
            </div>
            <div class="card-body">
                <div class="stack" style="gap:16px">
                    <form method="get" asp-action="Registrar" role="search" aria-label="Buscar asignación">
                        <label class="form-label" for="busqueda">Número de asignación, solicitud o equipo, marca, modelo o solicitante</label>
                        <div class="d-flex flex-wrap gap-2">
                            <input id="busqueda" name="busqueda" value="@Model.Busqueda" class="form-control flex-grow-1" style="min-width:220px;width:auto" autocomplete="off" maxlength="60" aria-describedby="busqueda-ayuda" />
                            <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Buscar</span></button>
                        </div>
                        <div class="form-text" id="busqueda-ayuda">Se muestran las asignaciones vigentes, primero las que vencen antes.</div>
                    </form>

                    @if (Model.Candidatas.Count == 0)
                    {
                        <div class="alert alert-info" role="status">
                            <partial name="_Icon" model="@("info")" />
                            <div class="alert-body">
                                <div class="alert-title">@(string.IsNullOrWhiteSpace(Model.Busqueda) ? "No hay asignaciones vigentes" : "No se encontró ninguna asignación vigente")</div>
                                <div>@(string.IsNullOrWhiteSpace(Model.Busqueda) ? "Para entregar un equipo primero hay que asignarlo a una solicitud." : "Revisar el dato ingresado.")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="list-unstyled m-0 stack" style="gap:8px" aria-label="Asignaciones vigentes">
                            @foreach (var asignacion in Model.Candidatas)
                            {
                                <li class="card">
                                    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2" style="padding: 12px 16px">
                                        <div>
                                            <div class="fw-semibold">@asignacion.MarcaYModelo</div>
                                            <div class="card-sub">
                                                <span class="mono">@asignacion.Codigo</span> · @asignacion.Solicitante · Retiro hasta el @asignacion.FechaLimiteRetiro.ToString("dd/MM/yyyy")
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (asignacion.PlazoVencido)
                                            {
                                                <partial name="_Badge" model="@(("Plazo vencido", "danger"))" />
                                            }
                                            <a class="btn btn-primary btn-sm" asp-action="Registrar" asp-route-nroAsignacion="@asignacion.NroAsignacion" aria-label="Elegir la asignación @asignacion.Codigo">Elegir</a>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary btn-lg" asp-action="Index">Cancelar</a>
            </div>
        </section>
    }
    else if (Model.Situacion == SituacionEntrega.NoEncontrada)
    {
        <div class="page-head">
            <div>
                <div class="h-id"><h1 tabindex="-1">Registrar entrega</h1></div>
            </div>
        </div>

        <div class="alert alert-danger" role="alert">
            <partial name="_Icon" model="@("x-circle")" />
            <div class="alert-body">
                <div class="alert-title">No se encontró la asignación</div>
                <div>El número no corresponde a ninguna asignación. Elegir una de las vigentes.</div>
            </div>
        </div>

        <div>
            <a class="btn btn-primary" asp-action="Registrar"><partial name="_Icon" model="@("swap")" /><span>Elegir asignación</span></a>
        </div>
    }
    else if (Model.Situacion == SituacionEntrega.NoVigente)
    {
        <div class="page-head">
            <div>
                <div class="h-id">
                    <h1 tabindex="-1">Registrar entrega</h1>
                    <partial name="_EstadoAsignacionBadge" model="Model.EstadoAsignacion!.Value" />
                </div>
                <p class="page-sub">Asignación <span class="mono">@Model.CodigoAsignacion</span> · @Model.MarcaYModelo</p>
            </div>
        </div>

        <div class="alert alert-danger" role="alert">
            <partial name="_Icon" model="@("x-circle")" />
            <div class="alert-body">
                <div class="alert-title">No se puede registrar esta entrega</div>
                <div>Esta asignación no está vigente. Solo se puede entregar un equipo con una asignación vigente.</div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-secondary" asp-controller="Asignaciones" asp-action="Detalle" asp-route-id="@Model.NroAsignacion"><partial name="_Icon" model="@("eye")" /><span>Ver asignación</span></a>
            <a class="btn btn-primary" asp-action="Registrar"><partial name="_Icon" model="@("swap")" /><span>Elegir otra asignación</span></a>
        </div>
    }
    else if (Model.Situacion == SituacionEntrega.PlazoVencido)
    {
        <div class="page-head">
            <div>
                <div class="h-id">
                    <h1 tabindex="-1">Registrar entrega</h1>
                    <partial name="_EstadoAsignacionBadge" model="Model.EstadoAsignacion!.Value" />
                </div>
                <p class="page-sub">Asignación <span class="mono">@Model.CodigoAsignacion</span> · @Model.MarcaYModelo</p>
            </div>
        </div>

        <div class="alert alert-warning" role="alert">
            <partial name="_Icon" model="@("alert")" />
            <div class="alert-body">
                <div class="alert-title">El plazo de retiro venció el @Model.FechaLimiteRetiro.ToString("dd/MM/yyyy")</div>
                <div>No se puede entregar el equipo con una asignación vencida. Conviene liberarla para que vuelva a estar disponible y otras personas en espera puedan acceder a él.</div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Asignaciones" asp-action="Detalle" asp-route-id="@Model.NroAsignacion"><partial name="_Icon" model="@("undo")" /><span>Ir a liberar la asignación</span></a>
            <a class="btn btn-secondary" asp-action="Registrar"><partial name="_Icon" model="@("swap")" /><span>Elegir otra asignación</span></a>
        </div>
    }
    else
    {
        <div class="page-head">
            <div>
                <div class="h-id">
                    <h1 tabindex="-1">Registrar entrega</h1>
                    <partial name="_EstadoAsignacionBadge" model="Model.EstadoAsignacion!.Value" />
                </div>
                <p class="page-sub">Asignación <span class="mono">@Model.CodigoAsignacion</span> · @Model.MarcaYModelo</p>
            </div>
            <div class="page-actions">
                <a class="btn btn-secondary" asp-controller="Asignaciones" asp-action="Detalle" asp-route-id="@Model.NroAsignacion"><partial name="_Icon" model="@("arrow-left")" /><span>Volver a la asignación</span></a>
            </div>
        </div>

        <section class="card" aria-labelledby="titulo-resumen">
            <div class="card-header">
                <div><h2 class="card-title" id="titulo-resumen">Qué se entrega</h2></div>
            </div>
            <div class="card-body">
                <dl class="dl">
                    <dt>Equipo</dt>
                    <dd>@Model.MarcaYModelo<div class="card-sub"><partial name="_TipoEquipo" model="Model.TipoEquipo" /> · <span class="mono">@Model.CodigoEquipo</span></div></dd>
                    <dt>Solicitud</dt>
                    <dd><span class="mono">@Model.CodigoSolicitud</span> · @Model.Solicitante (@Html.DisplayFor(m => m.TipoSolicitante))</dd>
                    <dt>Retiro hasta</dt>
                    <dd>@Model.FechaLimiteRetiro.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </section>

        <form class="card" method="post" asp-action="Registrar" id="f-entrega" novalidate aria-labelledby="titulo-datos">
            <input type="hidden" asp-for="NroAsignacion" />

            <div class="card-header">
                <div><h2 class="card-title" id="titulo-datos">Quién retira el equipo</h2></div>
            </div>
            <div class="card-body">
                <div class="stack" style="gap:16px">
                    <partial name="_ResumenErrores" />

                    <p class="form-note"><span class="req" aria-hidden="true">*</span> Campo obligatorio</p>

                    <div class="form-grid">
                        <div class="field span-2">
                            <label class="form-label" for="NombreQuienRetira">Nombre y apellido de quien retira<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                            <input asp-for="NombreQuienRetira" class="form-control" autocomplete="off" maxlength="100" />
                            <span asp-validation-for="NombreQuienRetira"></span>
                        </div>
                        <div class="field span-2">
                            <label class="form-label" for="DocumentoQuienRetira">Documento de quien retira<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                            <input asp-for="DocumentoQuienRetira" class="form-control" inputmode="numeric" maxlength="11" autocomplete="off" aria-describedby="DocumentoQuienRetira-hint" />
                            <div class="form-text" id="DocumentoQuienRetira-hint">
                                @if (Model.RequiereCoincidenciaDeDocumento)
                                {
                                    <text>Sin puntos ni espacios. Tiene que coincidir con el documento de la persona titular de la solicitud: pedir el documento original a quien retira.</text>
                                }
                                else
                                {
                                    <text>Sin puntos ni espacios. No se compara con ningún dato: verificar la identidad de quien retira y que esté autorizado por la organización solicitante.</text>
                                }
                            </div>
                            <span asp-validation-for="DocumentoQuienRetira"></span>
                        </div>
                        <div class="field">
                            <label class="form-label" for="CoordinadorVisible">Coordinador</label>
                            <input id="CoordinadorVisible" class="form-control" value="@Model.Coordinador" disabled />
                        </div>
                        <div class="field">
                            <label class="form-label" for="FechaEntregaVisible">Fecha de entrega</label>
                            <input id="FechaEntregaVisible" class="form-control" value="@Model.FechaEntrega.ToString("dd/MM/yyyy")" disabled aria-describedby="FechaEntrega-hint" />
                            <div class="form-text" id="FechaEntrega-hint">Es la de hoy y no se puede cambiar.</div>
                        </div>
                    </div>

                    <div class="alert alert-info" role="note">
                        <partial name="_Icon" model="@("info")" />
                        <div class="alert-body">
                            <div>Al registrar la entrega, la asignación pasa a Concretada, el equipo a Entregado y la solicitud a Completada. No se puede deshacer.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary btn-lg" asp-controller="Asignaciones" asp-action="Detalle" asp-route-id="@Model.NroAsignacion">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg" id="registrar-entrega"><partial name="_Icon" model="@("truck")" /><span>Registrar entrega</span></button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // evita registrar dos veces con un doble clic: el servidor también lo impide con un índice único
        document.getElementById('f-entrega')?.addEventListener('submit', function (e) {
            if (!e.defaultPrevented) {
                document.getElementById('registrar-entrega').disabled = true;
            }
        });
    </script>
}
