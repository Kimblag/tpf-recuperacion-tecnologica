@model TPF.RecuperacionTecnologica.Web.ViewModels.Administrador.AdministradorInicioViewModel
@{
    ViewData["Title"] = "Dashboard administrativo";
    var variacion = Model.VariacionEntregasPorcentaje switch
    {
        null => "Sin entregas el mes anterior",
        0 => "Sin cambios",
        > 0 and var positiva => $"+{positiva}%",
        var negativa => $"{negativa}%"
    };
    var claseVariacion = Model.VariacionEntregasPorcentaje switch
    {
        > 0 => "ok",
        < 0 => "warn",
        _ => ""
    };
    var detalleEntregas = Model.VariacionEntregasPorcentaje is null ? "Entregas del mes en curso" : "Respecto del mes anterior";
    string Cantidad(int n, string singular, string plural) => $"{n} {(n == 1 ? singular : plural)}";
    var usuariosNuevos = $"+{Model.UsuariosNuevosDelMes} este mes";
    var claseUsuariosNuevos = Model.UsuariosNuevosDelMes > 0 ? "ok" : "";
    var usuariosDetalle = $"Cuentas activas · {Cantidad(Model.UsuariosInactivos, "inactiva", "inactivas")}";
    var cuentasBloqueadas = Model.UsuariosBloqueados + Model.PersonalBloqueado;
    var bloqueadasDetalle = $"{Cantidad(Model.UsuariosBloqueados, "usuario externo", "usuarios externos")} · {Cantidad(Model.PersonalBloqueado, "del personal", "del personal")}";
    var enlaceBloqueadas = Model.UsuariosBloqueados == 0 && Model.PersonalBloqueado > 0
        ? Url.Action("Index", "Personal", new { bloqueadas = true })
        : Url.Action("Index", "Usuarios", new { acceso = "bloqueadas" });
    ViewDataDictionary ConEnlace(string? url) => new(ViewData) { ["Url"] = url };
    var personalDetalle = $"{Cantidad(Model.Administradores, "Administrador", "Administradores")} · {Cantidad(Model.Coordinadores, "Coordinador", "Coordinadores")} · {Cantidad(Model.Tecnicos, "Técnico", "Técnicos")}";
    var inactivos = Cantidad(Model.PersonalInactivo, "inactivo", "inactivos");
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li aria-current="page">Inicio</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Dashboard</h1></div>
            <p class="page-sub">Resumen administrativo de la plataforma</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" asp-controller="Usuarios" asp-action="Index"><partial name="_Icon" model="@("users")" /><span>Usuarios</span></a>
            <a class="btn btn-secondary" asp-controller="Parametros" asp-action="Index"><partial name="_Icon" model="@("sliders")" /><span>Parámetros</span></a>
            <a class="btn btn-secondary" asp-controller="Reportes" asp-action="Index"><partial name="_Icon" model="@("file")" /><span>Ver reportes</span></a>
            <a class="btn btn-primary" asp-controller="Personal" asp-action="Alta"><partial name="_Icon" model="@("plus")" /><span>Alta de personal</span></a>
        </div>
    </div>

    <div class="g-metrics g-metrics-auto">
        <partial name="_Metrica" model="@(("Usuarios externos", "users", "i-info", Model.UsuariosExternos.ToString(), usuariosNuevos, claseUsuariosNuevos, usuariosDetalle))" view-data='ConEnlace(Url.Action("Index", "Usuarios"))' />
        <partial name="_Metrica" model="@(("Personal activo", "idcard", "i-ok", Model.PersonalActivo.ToString(), inactivos, "", personalDetalle))" view-data='ConEnlace(Url.Action("Index", "Personal"))' />
        <partial name="_Metrica" model="@(("Equipos registrados", "laptop", "i-ok", Model.EquiposRegistrados.ToString(), "", "", "En todos los estados"))" view-data='ConEnlace(Url.Action("Index", "Equipos"))' />
        <partial name="_Metrica" model="@(("Entregas este mes", "truck", "i-ok", Model.EntregasDelMes.ToString(), variacion, claseVariacion, detalleEntregas))" view-data='ConEnlace(Url.Action("Index", "Entregas"))' />
        <partial name="_Metrica" model="@(("Cuentas bloqueadas", "lock", cuentasBloqueadas > 0 ? "i-warn" : "i-ok", cuentasBloqueadas.ToString(), "", "", bloqueadasDetalle))" view-data='ConEnlace(enlaceBloqueadas)' />
    </div>

    <section class="card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Equipos por estado</h2>
                <p class="card-sub">Distribución actual del inventario (Total: @Model.EquiposRegistrados equipos)</p>
            </div>
            <a class="link" asp-controller="Reportes" asp-action="EquiposPorEstado">Ver reporte</a>
        </div>
        <div class="card-body">
            @if (Model.EquiposRegistrados == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("laptop")" /></span>
                    <h3>Sin equipos registrados</h3>
                    <p>La distribución aparece cuando se registren donaciones.</p>
                </div>
            }
            else
            {
                <partial name="_DistribucionEquipos" model="Model.EquiposPorEstado" />
            }
        </div>
    </section>

    <section class="card overflow">
        <div class="card-header">
            <div>
                <h2 class="card-title">Auditoría reciente</h2>
                <p class="card-sub">Últimas operaciones registradas</p>
            </div>
        </div>
        <div class="card-body flush">
            @if (Model.AuditoriaReciente.Count == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("history")" /></span>
                    <h3>Sin movimientos recientes</h3>
                    <p>Las operaciones del sistema se registran aquí.</p>
                </div>
            }
            else
            {
                <partial name="_TablaAuditoria" model="Model.AuditoriaReciente" />
            }
            <div class="card-foot center">
                <a asp-controller="Auditoria" asp-action="Index">Ver registro completo de auditoría →</a>
            </div>
        </div>
    </section>
</div>
