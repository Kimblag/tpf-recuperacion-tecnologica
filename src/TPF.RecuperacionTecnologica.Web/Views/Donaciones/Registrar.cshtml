@model TPF.RecuperacionTecnologica.Web.ViewModels.Donaciones.RegistroDonacionViewModel
@using TPF.RecuperacionTecnologica.Web.Services.Cuenta
@{
    ViewData["Title"] = "Nueva donación";

    ViewData["Donante"] = User.FindFirst(ClaimsSesion.Nombre)?.Value ?? string.Empty;
    ViewData["NroEquipo"] = "Se asigna al registrar";
    ViewData["AyudaNroEquipo"] = "Se asigna automáticamente al registrar.";
    ViewData["Fecha"] = DateTime.Today.ToString("dd/MM/yyyy");
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Mis donaciones</a></li>
    <li aria-current="page">Nueva donación</li>
}

<div class="stack narrow">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Nueva donación</h1></div>
            <p class="page-sub">Cuéntenos qué equipo quiere donar. Después tendrá que llevarlo para que lo recibamos.</p>
        </div>
    </div>

    <form class="card" asp-action="Registrar" method="post" id="f-donacion" data-formulario-donacion novalidate aria-labelledby="f-donacion-titulo">
        <div class="card-header">
            <div><h2 class="card-title" id="f-donacion-titulo">Datos del equipo</h2></div>
        </div>
        <div class="card-body">
            <div class="stack" style="gap:16px">
                <partial name="_ResumenErrores" />

                <p class="form-note"><span class="req" aria-hidden="true">*</span> Campo obligatorio</p>

                <div class="form-grid">
                    <partial name="_CamposDonacion" model="Model" />
                </div>
            </div>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary btn-lg" asp-action="Index">Cancelar</a>
            <button type="submit" class="btn btn-primary btn-lg">Registrar donación</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/donacion-formulario.js" asp-append-version="true"></script>
}