@model TPF.RecuperacionTecnologica.Web.ViewModels.Donaciones.MisDonacionesViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Donaciones
@{
    ViewData["Title"] = "Mis donaciones";

    Func<int, string?> enlacePagina = pagina => Url.Action("Index", new
    {
        Busqueda = Model.Busqueda,
        Estado = Model.Estado,
        Tipo = Model.Tipo,
        Condicion = Model.Condicion,
        Orden = Model.Orden,
        Pagina = pagina
    });

    string Nombre<T>(T valor) where T : struct, Enum =>
        Html.GetEnumSelectList<T>().First(i => i.Value == Convert.ToInt32(valor).ToString()).Text;

    string? EnlaceSin(string filtro) => Url.Action("Index", new
    {
        Busqueda = filtro == "Busqueda" ? null : Model.Busqueda,
        Estado = filtro == "Estado" ? null : Model.Estado,
        Tipo = filtro == "Tipo" ? null : Model.Tipo,
        Condicion = filtro == "Condicion" ? null : Model.Condicion,
        Orden = Model.Orden
    });
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li aria-current="page">Mis donaciones</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Mis donaciones</h1></div>
            <p class="page-sub">Equipos que registró para donar y su estado actual</p>
        </div>
        @if (Model.Filas.Count > 0 || Model.HayFiltros || Model.ErrorAlCargar)
        {
            <div class="page-actions">
                <a class="btn btn-primary" asp-action="Registrar"><partial name="_Icon" model="@("plus")" /><span>Nueva donación</span></a>
            </div>
        }
    </div>

    <section class="card overflow" aria-label="Mis donaciones" data-listado data-filas-carga="6" data-lista-guardar="mis-donaciones">
        <partial name="_AyudaEstadosDonacion" />

        <form class="filters" role="search" method="get" asp-action="Index" data-filtros-automaticos>
            <div class="filter grow">
                <label for="Busqueda">Buscar</label>
                <input asp-for="Busqueda" class="form-control sm" placeholder="Nº de equipo, marca o modelo" maxlength="60" data-filtro-texto />
            </div>
            <div class="filter">
                <label for="Estado">Estado</label>
                <div class="select">
                    <select asp-for="Estado" class="form-select sm" asp-items="Html.GetEnumSelectList<EstadoEquipo>()">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter">
                <label for="Tipo">Tipo de equipo</label>
                <div class="select">
                    <select asp-for="Tipo" class="form-select sm" asp-items="Html.GetEnumSelectList<TipoEquipo>()">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter">
                <label for="Condicion">Condición declarada</label>
                <div class="select">
                    <select asp-for="Condicion" class="form-select sm" asp-items="Html.GetEnumSelectList<EstadoInicialDeclarado>()">
                        <option value="">Todas</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter d-md-none">
                <label for="Orden">Ordenar por</label>
                <div class="select">
                    <select asp-for="Orden" class="form-select sm" asp-items="Html.GetEnumSelectList<OrdenDonacion>()"></select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter" style="min-width:0">
                <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Filtrar</span></button>
            </div>
            <div class="filter" style="min-width:0">
                <a class="btn btn-ghost" asp-action="Index" data-muestra-carga>Limpiar</a>
            </div>
        </form>

        @if (Model.HayFiltros && !Model.ErrorAlCargar)
        {
            <div class="filtros-activos" aria-label="Filtros aplicados">
                <span class="filtros-activos-total" role="status">@(Model.Total == 1 ? "1 resultado" : $"{Model.Total} resultados")</span>

                @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
                {
                    <span class="filtro-activo">
                        <span>Búsqueda: “@Model.Busqueda”</span>
                        <a href="@EnlaceSin("Busqueda")" aria-label="Quitar el filtro de búsqueda" data-muestra-carga><partial name="_Icon" model="@("x")" /></a>
                    </span>
                }
                @if (Model.Estado is not null)
                {
                    <span class="filtro-activo">
                        <span>Estado: @Nombre(Model.Estado.Value)</span>
                        <a href="@EnlaceSin("Estado")" aria-label="Quitar el filtro de estado" data-muestra-carga><partial name="_Icon" model="@("x")" /></a>
                    </span>
                }
                @if (Model.Tipo is not null)
                {
                    <span class="filtro-activo">
                        <span>Tipo: @Nombre(Model.Tipo.Value)</span>
                        <a href="@EnlaceSin("Tipo")" aria-label="Quitar el filtro de tipo de equipo" data-muestra-carga><partial name="_Icon" model="@("x")" /></a>
                    </span>
                }
                @if (Model.Condicion is not null)
                {
                    <span class="filtro-activo">
                        <span>Condición: @Nombre(Model.Condicion.Value)</span>
                        <a href="@EnlaceSin("Condicion")" aria-label="Quitar el filtro de condición declarada" data-muestra-carga><partial name="_Icon" model="@("x")" /></a>
                    </span>
                }

                <a class="link" asp-action="Index" data-muestra-carga>Quitar todos</a>
            </div>
        }

        <div class="card-body flush">
            @if (Model.ErrorAlCargar)
            {
                <div class="state err" role="alert">
                    <span class="state-ic"><partial name="_Icon" model="@("alert")" /></span>
                    <h3>No se pudo cargar la información</h3>
                    <p>Ocurrió un error al obtener sus donaciones. Intente nuevamente en unos minutos.</p>
                    <a class="btn btn-secondary btn-sm" href="@(Context.Request.Path + Context.Request.QueryString)"><partial name="_Icon" model="@("refresh")" /><span>Reintentar</span></a>
                </div>
            }
            else if (Model.Filas.Count == 0 && Model.HayFiltros)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("filter")" /></span>
                    <h3>No hay donaciones que coincidan</h3>
                    <p>Pruebe con otra búsqueda o quite algún filtro.</p>
                    <a class="btn btn-secondary" asp-action="Index" data-muestra-carga>Limpiar filtros</a>
                </div>
            }
            else if (Model.Filas.Count == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("gift")" /></span>
                    <h3>Todavía no registró donaciones</h3>
                    <p>Cuando registre un equipo para donar aparecerá en esta lista.</p>
                    <a class="btn btn-primary" asp-action="Registrar"><partial name="_Icon" model="@("plus")" /><span>Nueva donación</span></a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-stack">
                        <caption class="visually-hidden">Mis donaciones</caption>
                        <thead>
                            <tr>
                                <partial name="_EncabezadoOrdenable" model="@(("Equipo", OrdenDonacion.EquipoAsc, OrdenDonacion.EquipoDesc, false, Model))" />
                                <partial name="_EncabezadoOrdenable" model="@(("Tipo", OrdenDonacion.TipoAsc, OrdenDonacion.TipoDesc, false, Model))" />
                                <partial name="_EncabezadoOrdenable" model="@(("Marca y modelo", OrdenDonacion.ModeloAsc, OrdenDonacion.ModeloDesc, false, Model))" />
                                <partial name="_EncabezadoOrdenable" model="@(("Condición declarada", OrdenDonacion.CondicionAsc, OrdenDonacion.CondicionDesc, false, Model))" />
                                <partial name="_EncabezadoOrdenable" model="@(("Registro", OrdenDonacion.RegistroAsc, OrdenDonacion.RegistroDesc, true, Model))" />
                                <partial name="_EncabezadoOrdenable" model="@(("Estado", OrdenDonacion.EstadoAsc, OrdenDonacion.EstadoDesc, false, Model))" />
                                <th scope="col" class="col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in Model.Filas)
                            {
                                <tr>
                                    <td data-label="Equipo"><span class="mono">@fila.CodigoEquipo</span></td>
                                    <td data-label="Tipo"><partial name="_TipoEquipo" model="fila.TipoEquipo" /></td>
                                    <td data-label="Marca y modelo">@fila.MarcaYModelo</td>
                                    <td data-label="Condición declarada">@Html.DisplayFor(m => fila.EstadoInicialDeclarado)</td>
                                    <td data-label="Registro">@fila.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td data-label="Estado"><partial name="_PistaEstadoDonacion" model="fila.EstadoEquipo" /></td>
                                    <td class="col-actions" data-label="Acciones">
                                        <a class="btn btn-ghost btn-sm" asp-action="Detalle" asp-route-id="@fila.NroEquipo" aria-label="Ver equipo @fila.CodigoEquipo"><partial name="_Icon" model="@("eye")" /><span>Ver</span></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <partial name="_Paginador" model="@((Model.Pagina, Model.TotalPaginas, Model.Desde, Model.Hasta, Model.Total, enlacePagina))" />
            }
        </div>

        <template data-plantilla-carga>
            <div class="load-note" role="status"><partial name="_Icon" model="@("clock")" /><span>Cargando datos…</span></div>
        </template>
    </section>
</div>

@section Scripts {
    <script src="~/js/filtros-listado.js" asp-append-version="true"></script>
    <script src="~/js/listado-carga.js" asp-append-version="true"></script>
}
