@model TPF.RecuperacionTecnologica.Web.ViewModels.Donaciones.RegistroDonacionViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Donaciones
@{
    var condiciones = new[]
    {
        new SelectListItem("Funcional: anda bien", ((int)EstadoInicialDeclarado.Funcional).ToString()),
        new SelectListItem("Con fallas: anda, pero con problemas", ((int)EstadoInicialDeclarado.ConFallas).ToString()),
        new SelectListItem("Para repuestos: no anda", ((int)EstadoInicialDeclarado.ParaRepuestos).ToString())
    };

    string Tipos(params TipoEquipo[] tipos) => string.Join(",", tipos.Select(t => (int)t));
    var tipoBloqueado = Model is EdicionDonacionViewModel;
    var codigoEquipo = ViewData["NroEquipo"] as string;
}

<div class="field">
    @if (tipoBloqueado)
    {
        var textoTipo = Html.GetEnumSelectList<TipoEquipo>()
            .FirstOrDefault(i => i.Value == ((int)Model.TipoEquipo!.Value).ToString())?.Text;

        <label class="form-label" for="TipoEquipoVisible">Tipo de equipo</label>
        <input type="hidden" id="TipoEquipo" name="TipoEquipo" value="@((int)Model.TipoEquipo!.Value)" />
        <input id="TipoEquipoVisible" class="form-control" value="@textoTipo" disabled aria-describedby="TipoEquipo-hint" />
        <div class="form-text" id="TipoEquipo-hint">No se puede cambiar. Si hubo un error, hay que cancelar esta donación y registrar una nueva.</div>
    }
    else
    {
        <label class="form-label" for="TipoEquipo">Tipo de equipo<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
        <div class="select">
            <select asp-for="TipoEquipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoEquipo>()">
                <option value="">Seleccione…</option>
            </select>
            <partial name="_Icon" model="@("chevron-down")" />
        </div>
        <span asp-validation-for="TipoEquipo"></span>
    }
</div>
<div class="field">
    <label class="form-label" for="Marca">Marca<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
    <input asp-for="Marca" class="form-control" placeholder="Ej.: Lenovo" aria-describedby="Marca-hint" />
    <div class="form-text" id="Marca-hint">Suele estar escrita en el equipo. Por ejemplo: Lenovo, Dell, HP.</div>
    <span asp-validation-for="Marca"></span>
</div>
<div class="field">
    <label class="form-label" for="Modelo">Modelo<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
    <input asp-for="Modelo" class="form-control" placeholder="Ej.: ThinkPad T480" aria-describedby="Modelo-hint" />
    <div class="form-text" id="Modelo-hint">Suele estar en una etiqueta, atrás o debajo del equipo.</div>
    <span asp-validation-for="Modelo"></span>
</div>
<div class="field">
    <label class="form-label" for="EstadoInicialDeclarado">Estado del equipo<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
    <div class="select">
        <select asp-for="EstadoInicialDeclarado" class="form-select" asp-items="condiciones" aria-describedby="EstadoInicialDeclarado-hint">
            <option value="">Seleccione…</option>
        </select>
        <partial name="_Icon" model="@("chevron-down")" />
    </div>
    <div class="form-text" id="EstadoInicialDeclarado-hint">¿Funciona? Elegir la opción que mejor lo describe. Un técnico lo va a revisar.</div>
    <span asp-validation-for="EstadoInicialDeclarado"></span>
</div>

<h3 class="span-2 sec-title">Características técnicas</h3>
<p class="span-2 form-note" style="margin:-6px 0 0">Completar solo lo que se sepa. Un técnico va a revisar estos datos antes de mostrar el equipo en el catálogo. Elegir primero el tipo de equipo para ver qué datos se piden.</p>

<div class="field" data-tipos="@Tipos(TipoEquipo.Notebook, TipoEquipo.PcEscritorio)" hidden>
    <label class="form-label" for="Procesador">Procesador</label>
    <input asp-for="Procesador" class="form-control" placeholder="Ej.: Intel Core i5" aria-describedby="Procesador-hint" />
    <div class="form-text" id="Procesador-hint">Suele decir “Intel Core i5” o “AMD Ryzen 5”. Se puede dejar vacío.</div>
    <span asp-validation-for="Procesador"></span>
</div>
<div class="field" data-tipos="@Tipos(TipoEquipo.Notebook, TipoEquipo.PcEscritorio, TipoEquipo.Celular)" hidden>
    <label class="form-label" for="MemoriaRam">Memoria RAM</label>
    <input asp-for="MemoriaRam" class="form-control" placeholder="Ej.: 8 GB" />
    <span asp-validation-for="MemoriaRam"></span>
</div>
<div class="field" data-tipos="@Tipos(TipoEquipo.Notebook, TipoEquipo.PcEscritorio, TipoEquipo.Celular)" hidden>
    <label class="form-label" for="Almacenamiento">Almacenamiento</label>
    <input asp-for="Almacenamiento" class="form-control" placeholder="Ej.: 256 GB SSD" />
    <span asp-validation-for="Almacenamiento"></span>
</div>
<div class="field" data-tipos="@Tipos(TipoEquipo.Notebook, TipoEquipo.Monitor)" hidden>
    <label class="form-label" for="TamanoPantalla">Tamaño de pantalla</label>
    <input asp-for="TamanoPantalla" class="form-control" placeholder="Ej.: 14 pulgadas" />
    <span asp-validation-for="TamanoPantalla"></span>
</div>
<div class="field span-2" data-tipos="@Tipos(TipoEquipo.Notebook, TipoEquipo.Celular)" hidden>
    <label class="form-label" for="EstadoBateria">Estado de la batería</label>
    <input asp-for="EstadoBateria" class="form-control" placeholder="Ej.: dura 2 horas" />
    <span asp-validation-for="EstadoBateria"></span>
</div>
<div class="field span-2">
    <label class="form-label" for="Otros">Otros datos</label>
    <textarea asp-for="Otros" class="form-control" rows="2" maxlength="300"></textarea>
    <span asp-validation-for="Otros"></span>
</div>

<h3 class="span-2 sec-title">Observaciones</h3>

<div class="field span-2">
    <label class="form-label" for="Observaciones">Observaciones</label>
    <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="500" aria-describedby="Observaciones-hint"></textarea>
    <div class="form-text" id="Observaciones-hint">Accesorios incluidos, golpes, fallas conocidas u otros detalles.</div>
    <span asp-validation-for="Observaciones"></span>
</div>

<h3 class="span-2 sec-title">Registro</h3>

<div class="field">
    <label class="form-label" for="Donante">Donante</label>
    <input id="Donante" class="form-control" value="@ViewData["Donante"]" disabled aria-describedby="Donante-hint" />
    <div class="form-text" id="Donante-hint">@(ViewData["AyudaDonante"] ?? "Se completa con la cuenta de la sesión.")</div>
</div>
@if (!string.IsNullOrEmpty(codigoEquipo))
{
    <div class="field">
        <label class="form-label" for="NroEquipoVisible">Número de equipo</label>
        <input id="NroEquipoVisible" class="form-control" value="@codigoEquipo" disabled aria-describedby="NroEquipo-hint" />
        <div class="form-text" id="NroEquipo-hint">@ViewData["AyudaNroEquipo"]</div>
    </div>
}
<div class="field">
    <label class="form-label" for="FechaRegistroVisible">Fecha de registro</label>
    <input id="FechaRegistroVisible" class="form-control" value="@ViewData["Fecha"]" disabled />
</div>
