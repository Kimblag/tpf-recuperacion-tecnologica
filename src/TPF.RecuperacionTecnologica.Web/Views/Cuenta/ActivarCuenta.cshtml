@model TPF.RecuperacionTecnologica.Web.ViewModels.Cuenta.ActivarCuentaViewModel
@{
    ViewData["Title"] = "Elegí tu contraseña";
    Layout = "_LayoutAuth";

    var enlaceInvalido = ViewData["EnlaceInvalido"] is true;

    var erroresGenerales = ViewData.ModelState
        .Where(e => e.Key.Length == 0)
        .SelectMany(e => e.Value!.Errors)
        .ToList();
}

<div class="auth-card">
    <h1>Elegí tu contraseña</h1>

    @if (enlaceInvalido)
    {
        <div class="stack">
            <div class="alert alert-warning" role="alert" tabindex="-1" id="resumen-errores">
                <partial name="_Icon" model="@("alert")" />
                <div class="alert-body">
                    <div class="alert-title">El enlace venció o no es válido</div>
                    <div>El enlace de la invitación dura 3 días y se puede usar una sola vez. Para recibir uno nuevo, pedilo en la sede o usá la opción "¿Olvidaste tu contraseña?" con el mismo correo.</div>
                </div>
            </div>
        </div>

        <div class="auth-links">
            <a class="link" asp-action="RecuperarContrasena">¿Olvidaste tu contraseña?</a>
            <a class="link" asp-action="Login">Ir al inicio de sesión</a>
        </div>
    }
    else
    {
        <p class="lead">Para activar tu cuenta, elegí la contraseña con la que vas a ingresar.</p>

        <form asp-action="ActivarCuenta" method="post" id="f-activar" novalidate>
            <input type="hidden" asp-for="IdUsuario" />
            <input type="hidden" asp-for="Token" />

            <div class="stack">
                @if (erroresGenerales.Count > 0)
                {
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="resumen-errores">
                        <partial name="_Icon" model="@("x-circle")" />
                        <div class="alert-body">
                            @foreach (var error in erroresGenerales)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="field">
                    <label class="form-label" for="Password">Contraseña<span class="req-word"> (obligatorio)</span></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="Password-hint" />
                    <div class="form-text" id="Password-hint">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="field">
                    <label class="form-label" for="ConfirmPassword">Confirmar contraseña<span class="req-word"> (obligatorio)</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100"><span>Activar la cuenta</span></button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var resumen = document.getElementById('resumen-errores');
        if (resumen) resumen.focus();
    </script>
}
