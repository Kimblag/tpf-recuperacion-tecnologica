@model TPF.RecuperacionTecnologica.Web.ViewModels.Account.LoginViewModel

<h1>Iniciar Sesion</h1>

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div>
    <label asp-for="CorreoElectronico"></label>
    <input asp-for="CorreoElectronico" />
    <span asp-validation-for="CorreoElectronico"></span>
</div>
<div>
    <label asp-for="Password"></label>
    <input asp-for="Password" />
    <span asp-validation-for="Password"></span>
</div>
<div>
    <input asp-for="RecordarSesion" />
    <label asp-for="RecordarSesion"></label>
</div>
<button type="submit">Iniciar sesión</button>
</form>