@model TPF.RecuperacionTecnologica.Web.ViewModels.Cuenta.RegistroUsuarioViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_LayoutAuth";

    var esInstitucion = Model.TipoUsuario == TipoUsuario.Institucion;
    var camposConError = ViewData.ModelState.Where(e => e.Value is { Errors.Count: > 0 }).ToList();
}

<div class="auth-card wide">
    <h1>Crear cuenta</h1>
    <p class="lead">El registro es solo para usuarios externos. Las cuentas del personal las gestiona un Administrador.</p>

    <form asp-action="Registrar" method="post" id="f-reg" novalidate>
        <div class="stack">
            <div>
                @if (camposConError.Count > 0)
                {
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="resumen-errores">
                        <partial name="_Icon" model="@("x-circle")" />
                        <div class="alert-body">
                            <div class="alert-title">Hay @camposConError.Count @(camposConError.Count == 1 ? "dato" : "datos") para revisar</div>
                            <div>Corrígelo@(camposConError.Count == 1 ? "" : "s") y vuelve a intentar:</div>
                            <ul>
                                @foreach (var campo in camposConError)
                                {
                                    if (string.IsNullOrEmpty(campo.Key))
                                    {
                                        foreach (var error in campo.Value!.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    }
                                    else
                                    {
                                        var nombre = ViewData.ModelMetadata.Properties.FirstOrDefault(p => p.Name == campo.Key)?.DisplayName ?? campo.Key;
                                        var destino = campo.Key == nameof(Model.NroDocumento)
                                            ? (esInstitucion ? "NroDocumentoInstitucion" : "NroDocumentoPersona")
                                            : campo.Key;
                                        <li><a href="#@destino">@nombre</a></li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>

            <p class="form-note">Los datos marcados como “obligatorio” hay que completarlos para continuar. Los demás son opcionales.</p>

            <div>
                <span class="form-label" id="um-l">¿Te registras como persona o como institución?</span>
                <div class="check-row" role="radiogroup" aria-labelledby="um-l">
                    <label class="check">
                        <input type="radio" asp-for="TipoUsuario" id="TipoUsuario_Persona" value="Persona" />
                        <span>Persona</span>
                    </label>
                    <label class="check">
                        <input type="radio" asp-for="TipoUsuario" id="TipoUsuario_Institucion" value="Institucion" />
                        <span>Institución (escuela, organización social)</span>
                    </label>
                </div>
            </div>

            <input type="hidden" asp-for="TipoDocumento" />

            <div class="form-grid">
                <div class="span-2 form-grid" data-user-panel="Persona" hidden="@esInstitucion">
                    <div class="field">
                        <label class="form-label" for="NroDocumentoPersona">Documento (DNI)<span class="req-word"> (obligatorio)</span></label>
                        <input asp-for="NroDocumento" id="NroDocumentoPersona" class="form-control" inputmode="numeric" placeholder="12345678" disabled="@esInstitucion" />
                        <span asp-validation-for="NroDocumento"></span>
                    </div>
                    <div class="field">
                        <label class="form-label" for="Nombre">Nombre<span class="req-word"> (obligatorio)</span></label>
                        <input asp-for="Nombre" class="form-control" autocomplete="given-name" disabled="@esInstitucion" />
                        <span asp-validation-for="Nombre"></span>
                    </div>
                    <div class="field">
                        <label class="form-label" for="Apellido">Apellido<span class="req-word"> (obligatorio)</span></label>
                        <input asp-for="Apellido" class="form-control" autocomplete="family-name" disabled="@esInstitucion" />
                        <span asp-validation-for="Apellido"></span>
                    </div>
                </div>

                <div class="span-2 form-grid" data-user-panel="Institucion" hidden="@(!esInstitucion)">
                    <div class="field span-2">
                        <label class="form-label" for="RazonSocial">Razón Social<span class="req-word"> (obligatorio)</span></label>
                        <input asp-for="RazonSocial" class="form-control" autocomplete="organization" disabled="@(!esInstitucion)" />
                        <span asp-validation-for="RazonSocial"></span>
                    </div>
                    <div class="field">
                        <label class="form-label" for="NroDocumentoInstitucion">CUIT<span class="req-word"> (obligatorio)</span></label>
                        <input asp-for="NroDocumento" id="NroDocumentoInstitucion" class="form-control" inputmode="numeric" placeholder="30123456789" aria-describedby="NroDocumentoInstitucion-hint" disabled="@(!esInstitucion)" />
                        <div class="form-text" id="NroDocumentoInstitucion-hint">Sin guiones ni espacios.</div>
                        <span asp-validation-for="NroDocumento"></span>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label" for="Telefono">Teléfono<span class="req-word"> (opcional)</span></label>
                    <input asp-for="Telefono" type="tel" class="form-control" autocomplete="tel" inputmode="tel" placeholder="11 5555-0000" />
                    <span asp-validation-for="Telefono"></span>
                </div>
                <div class="field span-2">
                    <label class="form-label" for="Direccion">Dirección<span class="req-word"> (opcional)</span></label>
                    <input asp-for="Direccion" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="Direccion"></span>
                </div>
                <div class="field span-2">
                    <label class="form-label" for="CorreoElectronico">Correo electrónico<span class="req-word"> (obligatorio)</span></label>
                    <input asp-for="CorreoElectronico" class="form-control" autocomplete="email" />
                    <span asp-validation-for="CorreoElectronico"></span>
                </div>
                <div class="field">
                    <label class="form-label" for="Password">Contraseña<span class="req-word"> (obligatorio)</span></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="Password-hint" />
                    <div class="form-text" id="Password-hint">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="field">
                    <label class="form-label" for="ConfirmPassword">Confirmar contraseña<span class="req-word"> (obligatorio)</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn-primary btn-lg"><span>Crear cuenta</span></button>
            </div>
        </div>
    </form>

    <div class="auth-links">
        <span class="muted">¿Ya tienes cuenta?</span>
        <a class="link" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var radios = document.querySelectorAll('input[name="TipoUsuario"]');
            var paneles = document.querySelectorAll('[data-user-panel]');
            var tipoDocumento = document.getElementById('TipoDocumento');

            function sincronizar() {
                var modo = document.querySelector('input[name="TipoUsuario"]:checked').value;
                paneles.forEach(function (panel) {
                    var activo = panel.dataset.userPanel === modo;
                    panel.hidden = !activo;
                    panel.querySelectorAll('input').forEach(function (campo) { campo.disabled = !activo; });
                });
                tipoDocumento.value = modo === 'Institucion' ? 'Cuit' : 'Dni';
            }

            function limpiarErrores() {
                var resumen = document.getElementById('resumen-errores');
                if (resumen) resumen.remove();

                document.querySelectorAll('#f-reg .field-validation-error').forEach(function (span) {
                    span.textContent = '';
                    span.classList.remove('field-validation-error');
                    span.classList.add('field-validation-valid');
                });

                document.querySelectorAll('#f-reg .input-validation-error').forEach(function (campo) {
                    campo.classList.remove('input-validation-error');
                    campo.removeAttribute('aria-invalid');
                });
            }

            radios.forEach(function (radio) {
                radio.addEventListener('change', function () {
                    limpiarErrores();
                    sincronizar();
                });
            });
            sincronizar();

            var resumen = document.getElementById('resumen-errores');
            if (resumen) resumen.focus();
        })();
    </script>
}
