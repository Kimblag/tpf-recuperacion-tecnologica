@model TPF.RecuperacionTecnologica.Web.ViewModels.Usuarios.UsuarioDetalleViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Usuarios
@{
    ViewData["Title"] = "Detalle de usuario";

    var esPersona = Model.TipoUsuario == TipoUsuario.Persona;
    var estaActivo = Model.EstadoUsuario == EstadoUsuario.Activo;
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li><a asp-action="Index">Usuarios</a></li>
    <li aria-current="page">Detalle</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">@Model.NombreVisible</h1>
                <partial name="_EstadoUsuarioBadge" model="Model.EstadoUsuario" />
            </div>
            <p class="page-sub">Usuario externo @Model.Codigo</p>
        </div>
        <div class="page-actions">
            @if (estaActivo)
            {
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-inactivar"><partial name="_Icon" model="@("ban")" /><span>Inactivar</span></button>
            }
            <a class="btn btn-secondary" asp-action="Index"><partial name="_Icon" model="@("arrow-left")" /><span>Volver</span></a>
        </div>
    </div>

    @if (!estaActivo)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body">
                <div>Esta cuenta está inactiva desde el @(Model.FechaBaja is null ? "—" : Reloj.Fecha(Model.FechaBaja.Value)) y no puede iniciar sesión. No se puede reactivar.</div>
                @if (!string.IsNullOrWhiteSpace(Model.MotivoBaja))
                {
                    <div>Motivo: @Model.MotivoBaja</div>
                }
            </div>
        </div>
    }

    <div class="grid-2">
        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Datos del usuario</h2>
                    <p class="card-sub">Registro de usuario externo</p>
                </div>
            </div>
            <div class="card-body">
                <dl class="dl">
                    <dt>@(esPersona ? "Documento (DNI)" : "CUIT")</dt>
                    <dd><span class="mono">@Model.DocumentoFormateado</span></dd>
                    <dt>Dirección</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</dd>
                    <dt>Teléfono</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</dd>
                    <dt>Fecha de alta</dt>
                    <dd>@Reloj.Fecha(Model.FechaAlta)</dd>
                </dl>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Cuenta de acceso</h2>
                    <p class="card-sub">Credenciales de inicio de sesión</p>
                </div>
            </div>
            <div class="card-body">
                <dl class="dl">
                    <dt>Correo de acceso</dt>
                    <dd>@Model.CorreoElectronico</dd>
                    <dt>Tipo de usuario</dt>
                    <dd>@Html.DisplayFor(m => m.TipoUsuario)</dd>
                </dl>
            </div>
        </section>
    </div>
</div>

@if (estaActivo)
{
    <partial name="_ModalInactivar" model="new InactivarUsuarioViewModel { NroUsuario = Model.NroUsuario, NombreCompleto = Model.NombreVisible, Codigo = Model.Codigo }" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
