@model TPF.RecuperacionTecnologica.Web.ViewModels.Usuarios.UsuarioListadoViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Usuarios";

    Func<int, string?> enlacePagina = pagina => Url.Action("Index", new
    {
        Busqueda = Model.Busqueda,
        Tipo = Model.Tipo,
        Estado = Model.Estado,
        Acceso = Model.Acceso,
        Orden = Model.Orden,
        Pagina = pagina
    });
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li aria-current="page">Usuarios</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Usuarios</h1></div>
            <p class="page-sub">Usuarios externos registrados en la plataforma</p>
        </div>
    </div>

    @if (Model.FiltroInvalido)
    {
        <div class="alert alert-warning" role="status">
            <partial name="_Icon" model="@("alert")" />
            <div class="alert-body">Alguno de los filtros indicados no es válido y se ignoró.</div>
        </div>
    }

    <section class="card overflow" aria-label="Usuarios">
        <form class="filters" role="search" method="get" asp-action="Index">
            <input type="hidden" asp-for="Orden" />
            <div class="filter grow">
                <label for="Busqueda">Buscar</label>
                <input asp-for="Busqueda" class="form-control sm" placeholder="Nombre, razón social, documento o correo" maxlength="60" />
            </div>
            <div class="filter">
                <label for="Tipo">Tipo</label>
                <div class="select">
                    <select asp-for="Tipo" class="form-select sm" asp-items="Html.GetEnumSelectList<TipoUsuario>()">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter">
                <label for="Estado">Estado</label>
                <div class="select">
                    <select asp-for="Estado" class="form-select sm" asp-items="Html.GetEnumSelectList<EstadoUsuario>()">
                        <option value="">Todos</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter">
                <label for="Acceso">Acceso</label>
                <div class="select">
                    <select id="Acceso" name="acceso" class="form-select sm">
                        <option value="">Todos</option>
                        <option value="bloqueadas" selected="@(Model.Acceso == "bloqueadas")">Bloqueadas</option>
                        <option value="pendientes" selected="@(Model.Acceso == "pendientes")">Pendientes de activación</option>
                    </select>
                    <partial name="_Icon" model="@("chevron-down")" />
                </div>
            </div>
            <div class="filter" style="min-width:0">
                <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Filtrar</span></button>
            </div>
            <div class="filter" style="min-width:0">
                <a class="btn btn-ghost" asp-action="Index">Limpiar</a>
            </div>
        </form>

        <div class="card-body flush">
            @if (Model.Filas.Count == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("users")" /></span>
                    <h3>No se encontraron usuarios</h3>
                    <p>Probá con otra búsqueda o con otros filtros.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-stack">
                        <caption class="visually-hidden">Usuarios externos</caption>
                        <thead>
                            <tr>
                                <partial name="_EncabezadoOrden" model="@(("Usuario", "usuario", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Nombre o razón social", "nombre", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Documento", "documento", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Correo", "correo", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Teléfono", "telefono", Model.Orden, false))" />
                                <partial name="_EncabezadoOrden" model="@(("Alta", "alta", Model.Orden, true))" />
                                <partial name="_EncabezadoOrden" model="@(("Estado", "estado", Model.Orden, false))" />
                                <th scope="col" class="col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in Model.Filas)
                            {
                                <tr>
                                    <td data-label="Usuario"><a class="mono" asp-action="Detalle" asp-route-id="@fila.NroUsuario">@fila.Codigo</a></td>
                                    <td data-label="Nombre o razón social">@fila.NombreVisible</td>
                                    <td data-label="Documento"><span class="mono">@fila.DocumentoFormateado</span></td>
                                    <td data-label="Correo"><span class="muted">@fila.CorreoElectronico</span></td>
                                    <td data-label="Teléfono">@fila.Telefono</td>
                                    <td data-label="Alta">@Reloj.Fecha(fila.FechaAlta)</td>
                                    <td data-label="Estado"><partial name="_EstadoUsuarioBadge" model="fila.EstadoUsuario" />@if (fila.EstaBloqueada) { <partial name="_Badge" model='@(("Bloqueada", "warn"))' /> }@if (fila.PendienteActivacion) { <partial name="_Badge" model='@(("Pendiente de activación", "warn"))' /> }</td>
                                    <td class="col-actions" data-label="Acciones">
                                        <a class="btn btn-ghost btn-sm" asp-action="Detalle" asp-route-id="@fila.NroUsuario" aria-label="Ver @fila.Codigo"><partial name="_Icon" model="@("eye")" /><span>Ver</span></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <partial name="_Paginador" model="@((Model.Pagina, Model.TotalPaginas, Model.Desde, Model.Hasta, Model.Total, enlacePagina))" />
            }
        </div>
    </section>
</div>
