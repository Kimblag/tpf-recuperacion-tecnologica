@model TPF.RecuperacionTecnologica.Web.ViewModels.Reportes.GenerarReporteViewModel
@using TPF.RecuperacionTecnologica.Web.ViewModels.Reportes
@{
    ViewData["Title"] = "Reportes";
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li aria-current="page">Reportes</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Reportes</h1></div>
            <p class="page-sub">Elija un rango de fechas y el tipo de informe. Se calculan a partir de la información existente, sin guardarse como un registro aparte.</p>
        </div>
    </div>

    <form class="card" asp-action="Generar" method="post" id="f-reportes" novalidate aria-labelledby="f-reportes-titulo">
        <div class="card-header">
            <div><h2 class="card-title" id="f-reportes-titulo">Generar informe</h2></div>
        </div>
        <div class="card-body">
            <div class="stack" style="gap:16px">
                <partial name="_ResumenErrores" />

                <p class="form-note"><span class="req" aria-hidden="true">*</span> Campo obligatorio</p>

                <div class="form-grid">
                    <div class="field">
                        <label class="form-label" for="Desde">Fecha desde<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                        <input asp-for="Desde" type="date" class="form-control" />
                        <span asp-validation-for="Desde"></span>
                    </div>
                    <div class="field">
                        <label class="form-label" for="Hasta">Fecha hasta<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                        <input asp-for="Hasta" type="date" class="form-control" />
                        <span asp-validation-for="Hasta"></span>
                    </div>
                    <div class="field span-2">
                        <label class="form-label" for="Tipo">Tipo de informe<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                        <div class="select">
                            <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoReporte>()"></select>
                            <partial name="_Icon" model="@("chevron-down")" />
                        </div>
                        <span asp-validation-for="Tipo"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg"><partial name="_Icon" model="@("chart")" /><span>Generar informe</span></button>
        </div>
    </form>

    <div class="stack">
        <h2 class="card-title" style="font-size:15px">Accesos rápidos</h2>
        <div class="grid-3">
            <a class="card rep-card" asp-action="EquiposPorEstado">
                <div class="card-body">
                    <span class="act-ic"><partial name="_Icon" model="@("chart")" /></span>
                    <div>
                        <div class="card-title">Equipos por estado</div>
                        <p class="card-sub">Cantidad y proporción de equipos en cada estado del proceso.</p>
                        <span class="link">Ver reporte</span>
                    </div>
                </div>
            </a>
            <a class="card rep-card" asp-action="EntregasPorPeriodo">
                <div class="card-body">
                    <span class="act-ic"><partial name="_Icon" model="@("truck")" /></span>
                    <div>
                        <div class="card-title">Entregas por período</div>
                        <p class="card-sub">Equipos entregados por mes, trimestre o año.</p>
                        <span class="link">Ver reporte</span>
                    </div>
                </div>
            </a>
            <a class="card rep-card" asp-action="TiposSolicitados">
                <div class="card-body">
                    <span class="act-ic"><partial name="_Icon" model="@("laptop")" /></span>
                    <div>
                        <div class="card-title">Tipos de equipo más solicitados</div>
                        <p class="card-sub">Ranking de tipos de equipo según la cantidad de solicitudes.</p>
                        <span class="link">Ver reporte</span>
                    </div>
                </div>
            </a>
        </div>
        <p class="form-text">Los accesos rápidos muestran el período predeterminado; para un rango específico, use el formulario de arriba.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var resumen = document.getElementById('resumen-errores');
        if (resumen) resumen.focus();
    </script>
}
