@model TPF.RecuperacionTecnologica.Web.ViewModels.Reportes.ReporteExcepcionesViewModel
@{
    ViewData["Title"] = "Excepciones de gestión";
}

@section Migas {
    <li><a asp-controller="Administrador" asp-action="Inicio">Administrador</a></li>
    <li><a asp-action="Index">Reportes</a></li>
    <li aria-current="page">Excepciones de gestión</li>
}

<div class="stack">
    <partial name="_EncabezadoReporte" model="@(("Excepciones de gestión", "Asignaciones que no siguieron la prioridad sugerida y asignaciones liberadas, con su motivo.", Model.PeriodoConsultado, Model.ErrorAlCargar || Model.Total == 0 ? null : "ExportarExcepciones"))" />

    @if (Model.ErrorAlCargar)
    {
        <section class="card">
            <div class="card-body">
                <partial name="_ErrorCarga" model="@("Ocurrió un error al generar el informe de excepciones de gestión. Intentá de nuevo en unos minutos.")" />
            </div>
        </section>
    }
    else if (Model.Total == 0)
    {
        <partial name="_ReporteVacio" />
    }
    else
    {
        <section class="card overflow">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Excepciones</h2>
                    <p class="card-sub">Total: @Model.Total. La columna «Asignó» indica quién hizo la asignación original.</p>
                </div>
            </div>
            <div class="card-body flush">
                <div class="table-wrap">
                    <table class="table table-stack">
                        <caption class="visually-hidden">Excepciones de gestión</caption>
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Excepción</th>
                                <th scope="col">Equipo</th>
                                <th scope="col">Solicitud</th>
                                <th scope="col">Asignó</th>
                                <th scope="col">Justificación o motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in Model.Filas)
                            {
                                <tr>
                                    <td data-label="Fecha"><span class="mono">@fila.Fecha</span></td>
                                    <td data-label="Excepción">@fila.Tipo</td>
                                    <td data-label="Equipo">@fila.Equipo</td>
                                    <td data-label="Solicitud"><span class="mono">@fila.Solicitud</span></td>
                                    <td data-label="Asignó">@fila.Coordinador</td>
                                    <td data-label="Justificación o motivo">@fila.Detalle</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
</div>
