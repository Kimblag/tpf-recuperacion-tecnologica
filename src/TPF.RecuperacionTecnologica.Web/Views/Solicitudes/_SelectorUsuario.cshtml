@model TPF.RecuperacionTecnologica.Web.ViewModels.Solicitudes.SelectorUsuarioViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Solicitudes
@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var formularioId = ViewData["FormularioId"]?.ToString();
    var esExistente = Model.Modo == ModoUsuarioAsistido.Existente;
    var esPersona = Model.TipoUsuario == TipoUsuario.Persona;
}

<div class="stack" style="gap:16px">
    <div>
        <span class="form-label" id="selector-modo-etiqueta">¿De quién es la solicitud?</span>
        <nav aria-labelledby="selector-modo-etiqueta">
            <ul class="chips list-unstyled m-0">
                <li><a class="chip" href="@Url.Action(accion, new { modo = ModoUsuarioAsistido.Existente })" aria-current="@(esExistente ? "true" : null)">Usuario existente</a></li>
                <li><a class="chip" href="@Url.Action(accion, new { modo = ModoUsuarioAsistido.Nuevo })" aria-current="@(esExistente ? null : "true")">Usuario nuevo</a></li>
            </ul>
        </nav>
    </div>

    @if (esExistente)
    {
        <form method="get" action="@Url.Action(accion)" role="search" aria-label="Buscar usuario">
            <input type="hidden" name="modo" value="@ModoUsuarioAsistido.Existente" />
            <label class="form-label" for="busqueda">DNI o correo electrónico<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
            <div class="d-flex flex-wrap gap-2">
                <input id="busqueda" name="busqueda" value="@Model.Busqueda" class="form-control flex-grow-1" style="min-width:220px;width:auto" autocomplete="off" maxlength="254" aria-describedby="busqueda-ayuda" />
                <button type="submit" class="btn btn-secondary"><partial name="_Icon" model="@("filter")" /><span>Buscar</span></button>
            </div>
            <div class="form-text" id="busqueda-ayuda">Se busca entre los usuarios externos ya registrados.</div>
        </form>

        @if (Model.BusquedaRealizada)
        {
            <div role="status">
                @if (Model.Encontrado is null)
                {
                    <div class="alert alert-info">
                        <partial name="_Icon" model="@("info")" />
                        <div class="alert-body">
                            <div class="alert-title">No se encontró ningún usuario</div>
                            <div>Revisar el dato ingresado, o dar de alta a la persona con la opción "Usuario nuevo".</div>
                        </div>
                    </div>
                }
                else if (Model.Encontrado.EstadoUsuario != EstadoUsuario.Activo)
                {
                    <div class="alert alert-danger">
                        <partial name="_Icon" model="@("x-circle")" />
                        <div class="alert-body">
                            <div class="alert-title">Este usuario está inactivo</div>
                            <div>@Model.Encontrado.Nombre (DNI @Model.Encontrado.Documento) dio de baja su cuenta. No se puede registrar una solicitud a su nombre.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card" style="background-color: var(--app-surface-low)">
                        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2" style="padding: 12px 16px">
                            <div>
                                <div class="card-sub">Usuario seleccionado</div>
                                <div class="fw-semibold">@Model.Encontrado.Nombre</div>
                                <div class="card-sub">DNI <span class="mono">@Model.Encontrado.Documento</span> · @Model.Encontrado.CorreoElectronico</div>
                            </div>
                            <partial name="~/Views/Usuarios/_EstadoUsuarioBadge.cshtml" model="Model.Encontrado.EstadoUsuario" />
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div>
            <span class="form-label" id="selector-tipo-etiqueta">¿Es una persona o una institución?</span>
            <nav aria-labelledby="selector-tipo-etiqueta">
                <ul class="chips list-unstyled m-0">
                    <li><a class="chip" href="@Url.Action(accion, new { modo = ModoUsuarioAsistido.Nuevo, tipoUsuario = TipoUsuario.Persona })" aria-current="@(esPersona ? "true" : null)">Persona</a></li>
                    <li><a class="chip" href="@Url.Action(accion, new { modo = ModoUsuarioAsistido.Nuevo, tipoUsuario = TipoUsuario.Institucion })" aria-current="@(esPersona ? null : "true")">Institución (escuela u organización social)</a></li>
                </ul>
            </nav>
        </div>

        <p class="form-note mb-0"><span class="req" aria-hidden="true">*</span> Campo obligatorio</p>

        <div class="form-grid">
            @if (esPersona)
            {
                <div class="field">
                    <label class="form-label" for="Usuario_Nombre">Nombre<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                    <input asp-for="Nombre" form="@formularioId" class="form-control" autocomplete="off" maxlength="100" />
                    <span asp-validation-for="Nombre"></span>
                </div>
                <div class="field">
                    <label class="form-label" for="Usuario_Apellido">Apellido<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                    <input asp-for="Apellido" form="@formularioId" class="form-control" autocomplete="off" maxlength="100" />
                    <span asp-validation-for="Apellido"></span>
                </div>
                <div class="field">
                    <label class="form-label" for="Usuario_NroDocumento">DNI<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                    <input asp-for="NroDocumento" form="@formularioId" class="form-control" inputmode="numeric" maxlength="8" placeholder="12345678" aria-describedby="Usuario_NroDocumento-ayuda" />
                    <div class="form-text" id="Usuario_NroDocumento-ayuda">Se verifica que no esté ya registrado.</div>
                    <span asp-validation-for="NroDocumento"></span>
                </div>
            }
            else
            {
                <div class="field span-2">
                    <label class="form-label" for="Usuario_RazonSocial">Razón social<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                    <input asp-for="RazonSocial" form="@formularioId" class="form-control" autocomplete="off" maxlength="150" />
                    <span asp-validation-for="RazonSocial"></span>
                </div>
                <div class="field">
                    <label class="form-label" for="Usuario_NroDocumento">CUIT<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                    <input asp-for="NroDocumento" form="@formularioId" class="form-control" inputmode="numeric" maxlength="11" placeholder="30123456789" aria-describedby="Usuario_NroDocumento-ayuda" />
                    <div class="form-text" id="Usuario_NroDocumento-ayuda">Sin guiones ni espacios.</div>
                    <span asp-validation-for="NroDocumento"></span>
                </div>
            }

            <div class="field span-2">
                <label class="form-label" for="Usuario_Direccion">Dirección</label>
                <input asp-for="Direccion" form="@formularioId" class="form-control" autocomplete="off" maxlength="200" />
                <span asp-validation-for="Direccion"></span>
            </div>
            <div class="field">
                <label class="form-label" for="Usuario_Telefono">Teléfono</label>
                <input asp-for="Telefono" form="@formularioId" type="tel" class="form-control" inputmode="tel" maxlength="20" placeholder="11 5555-0000" />
                <span asp-validation-for="Telefono"></span>
            </div>
            <div class="field">
                <label class="form-label" for="Usuario_CorreoElectronico">Correo electrónico<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                <input asp-for="CorreoElectronico" form="@formularioId" type="email" class="form-control" autocomplete="off" maxlength="254" aria-describedby="Usuario_CorreoElectronico-ayuda" />
                <div class="form-text" id="Usuario_CorreoElectronico-ayuda">Se envía una invitación para que la persona defina su contraseña.</div>
                <span asp-validation-for="CorreoElectronico"></span>
            </div>
        </div>
    }
</div>
