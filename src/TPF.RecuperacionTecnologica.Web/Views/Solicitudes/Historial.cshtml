@model TPF.RecuperacionTecnologica.Web.ViewModels.Solicitudes.HistorialSolicitudesViewModel
@{
    ViewData["Title"] = "Historial de solicitudes";
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Mis solicitudes</a></li>
    <li aria-current="page">Historial</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id"><h1 tabindex="-1">Historial de solicitudes</h1></div>
            <p class="page-sub">Movimientos de todas las solicitudes, del más reciente al más antiguo</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" asp-action="Index"><partial name="_Icon" model="@("arrow-left")" /><span>Volver</span></a>
        </div>
    </div>

    <section class="card" aria-labelledby="titulo-movimientos">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="titulo-movimientos">Movimientos</h2>
                <p class="card-sub">Ordenados por fecha</p>
            </div>
        </div>
        <div class="card-body">
            @if (Model.ErrorAlCargar)
            {
                <partial name="_ErrorCarga" model="@("Ocurrió un error al obtener el historial. Se puede intentar de nuevo en unos minutos.")" />
            }
            else if (Model.Movimientos.Count == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("history")" /></span>
                    <h3>Todavía no hay movimientos</h3>
                    <p>Cuando se haga una solicitud, sus movimientos aparecerán aquí.</p>
                    <a class="btn btn-primary" asp-controller="Catalogo" asp-action="Index"><partial name="_Icon" model="@("laptop")" /><span>Ver catálogo</span></a>
                </div>
            }
            else
            {
                <partial name="_LineaDeTiempo" model="Model.Movimientos" />
            }
        </div>
    </section>
</div>
