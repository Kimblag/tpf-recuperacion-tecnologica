@model TPF.RecuperacionTecnologica.Web.ViewModels.Solicitudes.EditarMotivoSolicitudViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Editar solicitud";

    var textoTipo = Html.GetEnumSelectList<TipoSolicitante>().First(i => i.Value == ((int)Model.TipoSolicitante).ToString()).Text;
    var textoOrigen = Html.GetEnumSelectList<OrigenSolicitud>().First(i => i.Value == ((int)Model.OrigenSolicitud).ToString()).Text;
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Mis solicitudes</a></li>
    <li><a asp-action="Detalle" asp-route-id="@Model.NroSolicitud">@Model.Codigo</a></li>
    <li aria-current="page">Editar</li>
}

<div class="stack narrow">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">Editar solicitud</h1>
                <partial name="_EstadoSolicitudBadge" model="Model.EstadoSolicitud" />
            </div>
            <p class="page-sub">Solicitud <span class="mono">@Model.Codigo</span></p>
        </div>
    </div>

    @if (Model.PuedeEditarse)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body"><div>Solo se puede cambiar el motivo, y solo mientras la solicitud está Pendiente. El equipo y el tipo de solicitante no se pueden cambiar: para pedir otro equipo hay que hacer una nueva solicitud.</div></div>
        </div>

        <form class="card" method="post" asp-action="Editar" asp-route-id="@Model.NroSolicitud" id="f-solicitud-editar" novalidate aria-labelledby="f-solicitud-titulo">
            <div class="card-header">
                <div><h2 class="card-title" id="f-solicitud-titulo">Datos de la solicitud</h2></div>
            </div>
            <div class="card-body">
                <div class="stack" style="gap:16px">
                    <partial name="_ResumenErrores" />

                    <p class="form-note"><span class="req" aria-hidden="true">*</span> Campo obligatorio</p>

                    <div class="form-grid">
                        <div class="span-2">
                            <div class="card" style="background-color: var(--app-surface-low)">
                                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2" style="padding: 12px 16px">
                                    <div>
                                        <div class="card-sub">Equipo solicitado</div>
                                        <div class="fw-semibold">@Model.MarcaYModelo</div>
                                        <div class="card-sub"><partial name="_TipoEquipo" model="Model.TipoEquipo" /> · Nº <span class="mono">@Model.CodigoEquipo</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            <label class="form-label" for="Solicitante">Solicitante</label>
                            <input id="Solicitante" class="form-control" value="@Model.Solicitante" disabled />
                        </div>
                        <div class="field">
                            <label class="form-label" for="TipoVisible">Tipo de solicitante</label>
                            <input id="TipoVisible" class="form-control" value="@textoTipo" disabled />
                        </div>
                        <div class="field span-2">
                            <label class="form-label" for="MotivoSolicitud">Motivo de la solicitud<span class="req" aria-hidden="true">*</span><span class="visually-hidden"> (obligatorio)</span></label>
                            <textarea asp-for="MotivoSolicitud" class="form-control" rows="4" maxlength="500" placeholder="Contar para qué se necesita el equipo" aria-describedby="MotivoSolicitud-hint"></textarea>
                            <div class="form-text" id="MotivoSolicitud-hint">Con unas pocas líneas alcanza.</div>
                            <span asp-validation-for="MotivoSolicitud"></span>
                        </div>
                        <div class="field">
                            <label class="form-label" for="OrigenVisible">Origen</label>
                            <input id="OrigenVisible" class="form-control" value="@textoOrigen" disabled />
                        </div>
                        <div class="field">
                            <label class="form-label" for="FechaVisible">Fecha de solicitud</label>
                            <input id="FechaVisible" class="form-control" value="@Model.FechaSolicitud.ToString("dd/MM/yyyy")" disabled />
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary btn-lg" asp-action="Detalle" asp-route-id="@Model.NroSolicitud">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg">Guardar cambios</button>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body"><div>Esta solicitud ya no se puede editar: solo se puede mientras está Pendiente.</div></div>
        </div>

        <div>
            <a class="btn btn-secondary" asp-action="Detalle" asp-route-id="@Model.NroSolicitud"><partial name="_Icon" model="@("arrow-left")" /><span>Volver a la solicitud</span></a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
