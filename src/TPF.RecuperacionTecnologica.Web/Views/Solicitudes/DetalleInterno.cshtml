@model TPF.RecuperacionTecnologica.Web.ViewModels.Solicitudes.SolicitudDetalleViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@using TPF.RecuperacionTecnologica.Web.ViewModels.Compartido
@{
    ViewData["Title"] = "Detalle de solicitud";

    var esCoordinador = User.IsInRole(nameof(RolPersonal.Coordinador));

    // solo las asistidas: las de autoservicio las edita o cancela la propia persona
    var puedeModificarEnNombreDe = esCoordinador
        && Model.PuedeModificarse
        && Model.OrigenSolicitud == OrigenSolicitud.Asistida;

    // el Administrador va a su detalle de usuario; el Coordinador, a la ficha sin el documento
    var esAdministrador = User.IsInRole(nameof(RolPersonal.Administrador));

    var avisoEquipo = Model.PuedeModificarse ? DisponibilidadEquipoSolicitud.Mensaje(Model.EstadoEquipo) : null;
    var puedeAsignar = Model.PuedeModificarse && DisponibilidadEquipoSolicitud.EstaDisponible(Model.EstadoEquipo);

    var explicacionEstado = Model.EstadoSolicitud switch
    {
        EstadoSolicitud.Pendiente => "Se está esperando poder asignar el equipo.",
        EstadoSolicitud.Asignada => "Se asignó el equipo. La persona debe retirarlo hasta la fecha límite indicada.",
        EstadoSolicitud.Completada => "El equipo ya se retiró.",
        EstadoSolicitud.Cerrada => Model.MotivoCierre ?? "La solicitud se cerró.",
        _ => "La solicitud se canceló."
    };
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Gestion" data-volver-a="gestion-solicitudes">Solicitudes</a></li>
    <li aria-current="page">Detalle</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">Solicitud <span class="mono">@Model.Codigo</span></h1>
                <partial name="_EstadoSolicitudBadge" model="Model.EstadoSolicitud" />
            </div>
            <p class="page-sub page-sub-id">@Model.MarcaYModelo</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" asp-action="Gestion" data-volver-a="gestion-solicitudes"><partial name="_Icon" model="@("arrow-left")" /><span>Volver</span></a>
            @if (puedeModificarEnNombreDe)
            {
                <a class="btn btn-secondary" asp-action="EditarInterno" asp-route-id="@Model.NroSolicitud"><partial name="_Icon" model="@("edit")" /><span>Editar solicitud</span></a>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-cancelar-solicitud"><partial name="_Icon" model="@("x")" /><span>Cancelar solicitud</span></button>
            }
            @if (esCoordinador)
            {
                if (puedeAsignar)
                {
                    <a class="btn btn-primary" asp-controller="Asignaciones" asp-action="Asignar" asp-route-nroEquipo="@Model.NroEquipo"><partial name="_Icon" model="@("swap")" /><span>Asignar equipo</span></a>
                }
                else
                {
                    <button type="button" class="btn btn-secondary" disabled><partial name="_Icon" model="@("swap")" /><span>Asignar equipo</span></button>
                }
            }
        </div>
    </div>

    <partial name="_ResumenErrores" />

    @if (esCoordinador && avisoEquipo is not null)
    {
        <div class="alert alert-warning" role="note">
            <partial name="_Icon" model="@("alert")" />
            <div class="alert-body">
                <div>@avisoEquipo</div>
            </div>
        </div>
    }

    <div class="grid-3-1">
        <section class="card" aria-labelledby="titulo-datos">
            <div class="card-header">
                <div><h2 class="card-title" id="titulo-datos">Datos de la solicitud</h2></div>
            </div>
            <div class="card-body">
                <dl class="dl">
                    <dt>Equipo solicitado</dt>
                    <dd><a asp-controller="Equipos" asp-action="Detalle" asp-route-id="@Model.NroEquipo">@Model.MarcaYModelo</a><div class="card-sub"><partial name="_TipoEquipo" model="Model.TipoEquipo" /> · <span class="mono">@Model.CodigoEquipo</span></div></dd>
                    <dt>Solicitante</dt>
                    <dd><a asp-controller="Usuarios" asp-action="@(esAdministrador ? "Detalle" : "Ficha")" asp-route-id="@Model.NroUsuario">@Model.Solicitante</a><div class="card-sub">@Html.DisplayFor(m => m.TipoCuenta) · @Model.CorreoSolicitante</div></dd>
                    <dt>Tipo de solicitante</dt>
                    <dd>@Html.DisplayFor(m => m.TipoSolicitante)</dd>
                    <dt>Motivo</dt>
                    <dd>@Model.MotivoSolicitud</dd>
                    <dt>Origen</dt>
                    <dd>@Html.DisplayFor(m => m.OrigenSolicitud)</dd>
                    <dt>Fecha de solicitud</dt>
                    <dd>@Reloj.Fecha(Model.FechaSolicitud)</dd>
                    <dt>Situación actual</dt>
                    <dd>@explicacionEstado</dd>
                </dl>
            </div>
        </section>

        <div class="stack">
            <section class="card" aria-labelledby="titulo-historial">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="titulo-historial">Historial</h2>
                        <p class="card-sub">Eventos de la solicitud</p>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="_LineaDeTiempo" model="Model.Hitos" />
                </div>
            </section>

            <section class="card" aria-labelledby="titulo-prioridad">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="titulo-prioridad">Prioridad de asignación</h2>
                        <p class="card-sub">Regla de negocio</p>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="_ReglaPrioridad" />
                </div>
            </section>
        </div>
    </div>
</div>

@if (puedeModificarEnNombreDe)
{
    <partial name="_ModalCancelarSolicitudInterno" model="Model" />
}
