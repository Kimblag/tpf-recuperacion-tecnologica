@model TPF.RecuperacionTecnologica.Web.ViewModels.Equipos.GestionFotosViewModel
@using TPF.RecuperacionTecnologica.Web.Services.Equipos
@{
    ViewData["Title"] = "Fotos del equipo";

    var cantidad = Model.Fotos.Count;
    var maximoNuevas = Math.Min(Model.Disponibles, Model.MaximoPorEnvio);

    IEnumerable<string> OpcionesPara(string? actual) =>
        string.IsNullOrWhiteSpace(actual) || AngulosFoto.Opciones.Contains(actual)
            ? AngulosFoto.Opciones
            : AngulosFoto.Opciones.Append(actual);
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Equipos</a></li>
    <li><a asp-action="Detalle" asp-route-id="@Model.NroEquipo">@Model.CodigoEquipo</a></li>
    <li aria-current="page">Fotos</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">Fotos del equipo <span class="mono">@Model.CodigoEquipo</span></h1>
                <partial name="_EstadoEquipoBadge" model="Model.EstadoEquipo" />
            </div>
            <p class="page-sub page-sub-id">@Html.DisplayFor(m => m.TipoEquipo) @Model.MarcaYModelo</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" asp-action="Detalle" asp-route-id="@Model.NroEquipo"><partial name="_Icon" model="@("arrow-left")" /><span>Volver al equipo</span></a>
        </div>
    </div>

    <partial name="_ResumenErrores" />

    @if (!Model.PuedeEditar)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body">@Model.MotivoNoEditable</div>
        </div>
    }

    <section class="card" aria-labelledby="titulo-fotos-cargadas">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="titulo-fotos-cargadas">Fotos cargadas</h2>
                <p class="card-sub">@cantidad de @Model.MaximoPorEquipo</p>
            </div>
        </div>
        <div class="card-body">
            @if (cantidad == 0)
            {
                <div class="state">
                    <span class="state-ic"><partial name="_Icon" model="@("laptop")" /></span>
                    <h3>Sin fotos</h3>
                    <p>Este equipo todavía no tiene fotos cargadas.</p>
                </div>
            }
            else
            {
                <ul class="fotos-grid">
                    @for (var indice = 0; indice < cantidad; indice++)
                    {
                        var foto = Model.Fotos[indice];
                        var numero = indice + 1;
                        var textoAlt = $"Foto {numero} de {Model.MarcaYModelo}" + (string.IsNullOrWhiteSpace(foto.Angulo) ? string.Empty : $", vista {foto.Angulo}");
                        var leyenda = $"Foto {numero} de {cantidad}" + (string.IsNullOrWhiteSpace(foto.Angulo) ? string.Empty : $" · {foto.Angulo}");

                        <li class="foto-item">
                            <button type="button" class="foto-imagen" aria-label="Ampliar la foto @numero" data-visor-foto
                                    data-src="@Url.Content(foto.UrlImagen)" data-alt="@textoAlt" data-leyenda="@leyenda">
                                <img src="@Url.Content(foto.UrlImagen)" alt="@textoAlt" loading="lazy" />
                            </button>
                            <div class="foto-datos">
                                <div class="foto-titulo">
                                    <strong>Foto @numero</strong>
                                    @if (foto.NroDiagnostico is not null)
                                    {
                                        <span class="tag">DIA-@foto.NroDiagnostico.Value.ToString("D6")</span>
                                    }
                                </div>

                                @if (Model.PuedeEditar)
                                {
                                    <form class="foto-angulo" asp-action="ActualizarAnguloFoto" asp-route-id="@Model.NroEquipo" asp-route-nroImagen="@foto.NroImagen" method="post">
                                        <label class="visually-hidden" for="angulo-@foto.NroImagen">Ángulo de la foto @numero</label>
                                        <select id="angulo-@foto.NroImagen" name="angulo" class="form-select sm">
                                            <option value="">Sin ángulo</option>
                                            @foreach (var opcion in OpcionesPara(foto.Angulo))
                                            {
                                                <option value="@opcion" selected="@(opcion == foto.Angulo)">@opcion</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-secondary btn-sm">Guardar</button>
                                    </form>

                                    @if (Model.EsUltimaFotoProtegida)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" disabled aria-describedby="ayuda-ultima-foto"><partial name="_Icon" model="@("x")" /><span>Eliminar</span></button>
                                        <p class="form-text mb-0" id="ayuda-ultima-foto">Un equipo disponible debe conservar al menos una foto.</p>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-danger btn-sm" data-eliminar-foto
                                                data-accion="@Url.Action("EliminarFoto", new { id = Model.NroEquipo, nroImagen = foto.NroImagen })"
                                                data-detalle="Foto @numero@(string.IsNullOrWhiteSpace(foto.Angulo) ? string.Empty : $" ({foto.Angulo})")">
                                            <partial name="_Icon" model="@("x")" /><span>Eliminar</span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <p class="card-sub mb-0">@(string.IsNullOrWhiteSpace(foto.Angulo) ? "Sin ángulo" : foto.Angulo)</p>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    @if (Model.PuedeEditar && Model.Disponibles == 0)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body">Se alcanzó el máximo de @Model.MaximoPorEquipo fotos por equipo. Eliminar alguna para poder cargar otra.</div>
        </div>
    }
    else if (Model.PuedeEditar)
    {
        <form class="card" asp-action="AgregarFotos" asp-route-id="@Model.NroEquipo" method="post" enctype="multipart/form-data" novalidate aria-labelledby="titulo-agregar-fotos">
            <div class="card-header">
                <div>
                    <h2 class="card-title" id="titulo-agregar-fotos">Agregar fotos</h2>
                    <p class="card-sub">Se pueden agregar hasta @maximoNuevas @(maximoNuevas == 1 ? "foto más" : "fotos más") en este envío</p>
                </div>
            </div>
            <div class="card-body">
                <partial name="_CargaFotos" model="cantidad" />
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary btn-lg" data-cancelar-origen asp-action="Detalle" asp-route-id="@Model.NroEquipo">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg" disabled data-fotos-enviar data-fotos-enviar-con-fotos>Cargar fotos</button>
            </div>
        </form>
    }
</div>

@if (cantidad > 0)
{
    <partial name="_VisorFotos" />
}

@if (Model.PuedeEditar)
{
    <dialog class="dialogo-confirmar" aria-labelledby="titulo-eliminar-foto" data-eliminar-dialogo>
        <form method="post" asp-action="EliminarFoto" asp-route-id="@Model.NroEquipo" asp-route-nroImagen="0">
            <h2 class="card-title" id="titulo-eliminar-foto">Eliminar foto</h2>
            <p>Se eliminará la <span data-eliminar-detalle></span> del equipo. Esta acción no se puede deshacer.</p>
            <div class="dialogo-acciones">
                <button type="button" class="btn btn-secondary" data-eliminar-cancelar>Cancelar</button>
                <button type="submit" class="btn btn-danger">Eliminar</button>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script src="~/js/gestion-fotos.js" asp-append-version="true"></script>
}
