@model TPF.RecuperacionTecnologica.Web.ViewModels.Equipos.EquipoDetalleTecnicoViewModel
@using TPF.RecuperacionTecnologica.Web.Models.Enums
@{
    ViewData["Title"] = "Detalle de equipo";

    var esTecnico = User.IsInRole(nameof(RolPersonal.Tecnico));
    var esCoordinador = User.IsInRole(nameof(RolPersonal.Coordinador));
    var verSolicitudes = esCoordinador || User.IsInRole(nameof(RolPersonal.Administrador));

    string? Enlace(string accion) => Url.Action(accion, "Diagnosticos", new { nroEquipo = Model.NroEquipo });
}

@section Migas {
    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
    <li><a asp-action="Index">Equipos</a></li>
    <li aria-current="page">Detalle</li>
}

<div class="stack">
    <div class="page-head">
        <div>
            <div class="h-id">
                <h1 tabindex="-1">Equipo <span class="mono">@Model.CodigoEquipo</span></h1>
                <partial name="_EstadoEquipoBadge" model="Model.EstadoEquipo" />
            </div>
            <p class="page-sub">@Html.DisplayFor(m => m.TipoEquipo) @Model.MarcaYModelo · @TPF.RecuperacionTecnologica.Web.ViewModels.Compartido.ValidacionesNumeroSerie.EtiquetaPara(Model.TipoEquipo): @if (string.IsNullOrWhiteSpace(Model.NumeroSerie)) { <span class="muted">sin dato</span> } else { <span class="mono">@Model.NumeroSerie</span> }</p>
        </div>
        <div class="page-actions">
            @if (verSolicitudes)
            {
                <a class="btn btn-secondary" asp-action="Legajo" asp-route-id="@Model.NroEquipo"><partial name="_Icon" model="@("history")" /><span>Historial de equipo</span></a>
            }
            else
            {
                <a class="btn btn-secondary" asp-action="Historial" asp-route-id="@Model.NroEquipo"><partial name="_Icon" model="@("history")" /><span>Historial de diagnósticos</span></a>
            }
            @if (esTecnico)
            {
                <a class="btn btn-secondary" asp-action="Fotos" asp-route-id="@Model.NroEquipo"><partial name="_Icon" model="@("laptop")" /><span>Gestionar fotos</span></a>

                if (Model.PuedeRectificar)
                {
                    <partial name="_AccionDiagnostico" model="@(("Rectificar", "edit", Enlace("Rectificar"), false))" />
                }

                if (Model.PuedeRegistrarDiagnostico)
                {
                    <partial name="_AccionDiagnostico" model="@(("Registrar diagnóstico", "plus", Enlace("Registrar"), true))" />
                }

                if (Model.PuedeRegistrarSegundo)
                {
                    <partial name="_AccionDiagnostico" model="@(("Segundo diagnóstico", "wrench", Enlace("Segundo"), true))" />
                }
            }
            @if (esCoordinador)
            {
                if (Model.EstadoEquipo == EstadoEquipo.Disponible)
                {
                    <a class="btn btn-primary" asp-controller="Asignaciones" asp-action="Asignar" asp-route-nroEquipo="@Model.NroEquipo"><partial name="_Icon" model="@("swap")" /><span>Asignar equipo</span></a>
                }
                else
                {
                    <button type="button" class="btn btn-secondary" disabled><partial name="_Icon" model="@("swap")" /><span>Asignar equipo</span></button>
                }
            }
        </div>
    </div>

    @if (esTecnico && !Model.AdmiteAcciones)
    {
        <div class="alert alert-info" role="status">
            <partial name="_Icon" model="@("info")" />
            <div class="alert-body">Este equipo no admite acciones de diagnóstico en su estado actual.</div>
        </div>
    }

    <div class="g-detail">
        <partial name="_TarjetaFotosEquipo" model="@((Model.Fotos, Model.TipoEquipo, Model.Modelo, Model.MarcaYModelo))" />

        <div class="stack">
            <section class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Evaluación vigente</h2>
                        <p class="card-sub">Último dictamen técnico</p>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.DiagnosticoVigente is { } vigente)
                    {
                        <dl class="dl">
                            <dt>Diagnóstico</dt>
                            <dd><span class="mono">@vigente.CodigoDiagnostico</span></dd>
                            <dt>Tipo</dt>
                            <dd>@Html.DisplayFor(m => vigente.TipoDiagnostico)</dd>
                            <dt>Fecha</dt>
                            <dd>@vigente.FechaDiagnostico.ToString("dd/MM/yyyy")</dd>
                            <dt>Técnico</dt>
                            <dd>@vigente.Tecnico</dd>
                            <dt>Dictamen</dt>
                            <dd><partial name="_DictamenBadge" model="vigente.DictamenTecnico" /></dd>
                        </dl>
                    }
                    else
                    {
                        <div class="state">
                            <span class="state-ic"><partial name="_Icon" model="@("wrench")" /></span>
                            <h3>Sin diagnóstico</h3>
                            <p>Este equipo todavía no fue evaluado.</p>
                        </div>
                    }
                </div>
            </section>

            @if (esCoordinador)
            {
                <section class="card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Características técnicas</h2>
                            <p class="card-sub">Verificadas por el técnico en el diagnóstico</p>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.DiagnosticoVigente is { } verificado)
                        {
                            var hayVerificadas = new[] { verificado.Procesador, verificado.MemoriaRam, verificado.Almacenamiento, verificado.TamanoPantalla, verificado.EstadoBateria, verificado.Otros }
                                .Any(texto => !string.IsNullOrWhiteSpace(texto));

                            if (hayVerificadas)
                            {
                                <dl class="dl">
                                    @if (!string.IsNullOrWhiteSpace(verificado.Procesador))
                                    {
                                        <dt>Procesador</dt>
                                        <dd>@verificado.Procesador</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(verificado.MemoriaRam))
                                    {
                                        <dt>Memoria RAM</dt>
                                        <dd>@verificado.MemoriaRam</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(verificado.Almacenamiento))
                                    {
                                        <dt>Almacenamiento</dt>
                                        <dd>@verificado.Almacenamiento</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(verificado.TamanoPantalla))
                                    {
                                        <dt>Tamaño de pantalla</dt>
                                        <dd>@verificado.TamanoPantalla</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(verificado.EstadoBateria))
                                    {
                                        <dt>Estado de la batería</dt>
                                        <dd>@verificado.EstadoBateria</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(verificado.Otros))
                                    {
                                        <dt>Otros datos</dt>
                                        <dd>@verificado.Otros</dd>
                                    }
                                </dl>
                            }
                            else
                            {
                                <p class="muted">No se verificaron características técnicas.</p>
                            }
                        }
                        else
                        {
                            <p class="muted">Todavía no hay características verificadas.</p>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Declarado por el donante</h2>
                            <p class="card-sub">Para contrastar con lo que se encuentra en el equipo</p>
                        </div>
                    </div>
                    <div class="card-body">
                        <dl class="dl">
                            <dt>Condición declarada</dt>
                            <dd>@Html.DisplayFor(m => m.EstadoInicialDeclarado)</dd>
                            <dt>Observaciones</dt>
                            <dd>@if (string.IsNullOrWhiteSpace(Model.Observaciones)) { <span class="muted">Sin observaciones</span> } else { @Model.Observaciones }</dd>
                            @if (!string.IsNullOrWhiteSpace(Model.Procesador))
                            {
                                <dt>Procesador</dt>
                                <dd>@Model.Procesador</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.MemoriaRam))
                            {
                                <dt>Memoria RAM</dt>
                                <dd>@Model.MemoriaRam</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Almacenamiento))
                            {
                                <dt>Almacenamiento</dt>
                                <dd>@Model.Almacenamiento</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.TamanoPantalla))
                            {
                                <dt>Tamaño de pantalla</dt>
                                <dd>@Model.TamanoPantalla</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.EstadoBateria))
                            {
                                <dt>Estado de la batería</dt>
                                <dd>@Model.EstadoBateria</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Otros))
                            {
                                <dt>Otros datos</dt>
                                <dd>@Model.Otros</dd>
                            }
                            @if (!Model.TieneEspecificaciones)
                            {
                                <dt>Características técnicas</dt>
                                <dd><span class="muted">No se declararon</span></dd>
                            }
                        </dl>
                    </div>
                </section>
            }

            @if (!esCoordinador || Model.FechaDisponibilidad is not null || Model.EstadoEquipo == EstadoEquipo.Cancelado)
            {
                <section class="card">
                    <div class="card-header">
                        <div><h2 class="card-title">Datos del registro</h2></div>
                    </div>
                    <div class="card-body">
                        <dl class="dl">
                            @if (!esCoordinador)
                            {
                                <dt>Donante</dt>
                                <dd>@Model.Donante</dd>
                                <dt>Fecha de registro</dt>
                                <dd>@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                            }
                            @if (Model.FechaDisponibilidad is not null)
                            {
                                <dt>Disponible desde</dt>
                                <dd>@Model.FechaDisponibilidad.Value.ToString("dd/MM/yyyy")</dd>
                            }
                            @if (Model.EstadoEquipo == EstadoEquipo.Cancelado)
                            {
                                <dt>Fecha de cancelación</dt>
                                <dd>@(Model.FechaCancelacion?.ToString("dd/MM/yyyy") ?? "—")</dd>
                                <dt>Motivo de cancelación</dt>
                                <dd>@(string.IsNullOrWhiteSpace(Model.MotivoCancelacion) ? "—" : Model.MotivoCancelacion)</dd>
                            }
                        </dl>
                    </div>
                </section>
            }
        </div>
    </div>

    @if (verSolicitudes)
    {
        <section class="card overflow" aria-labelledby="titulo-solicitudes-equipo">
            <div class="card-header">
                <div>
                    <h2 class="card-title" id="titulo-solicitudes-equipo">Solicitudes sobre este equipo</h2>
                    <p class="card-sub">Las pendientes, en orden de prioridad: Escuela y Organización social antes que Particular, la más antigua primero</p>
                </div>
            </div>
            <div class="card-body flush">
                @if (Model.Solicitudes.Count == 0)
                {
                    <div class="state">
                        <span class="state-ic"><partial name="_Icon" model="@("tray")" /></span>
                        <h3>Sin solicitudes</h3>
                        <p>Todavía nadie solicitó este equipo.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table table-stack">
                            <caption class="visually-hidden">Solicitudes sobre el equipo</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Solicitud</th>
                                    <th scope="col">Solicitante</th>
                                    <th scope="col">Tipo de solicitante</th>
                                    <th scope="col">Origen</th>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fila in Model.Solicitudes)
                                {
                                    <tr>
                                        <td data-label="Solicitud"><a class="mono" asp-controller="Solicitudes" asp-action="DetalleInterno" asp-route-id="@fila.NroSolicitud">@fila.Codigo</a></td>
                                        <td data-label="Solicitante">@fila.Solicitante</td>
                                        <td data-label="Tipo de solicitante">@Html.DisplayFor(m => fila.TipoSolicitante)</td>
                                        <td data-label="Origen">@Html.DisplayFor(m => fila.OrigenSolicitud)</td>
                                        <td data-label="Fecha">@fila.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                        <td data-label="Estado"><partial name="_EstadoSolicitudBadge" model="fila.EstadoSolicitud" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/galeria-equipo.js" asp-append-version="true"></script>
}
