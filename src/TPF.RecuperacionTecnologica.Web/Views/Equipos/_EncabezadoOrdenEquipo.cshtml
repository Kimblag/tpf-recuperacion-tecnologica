@model (string Texto, TPF.RecuperacionTecnologica.Web.ViewModels.Equipos.OrdenEquipo Ascendente, TPF.RecuperacionTecnologica.Web.ViewModels.Equipos.OrdenEquipo Descendente, TPF.RecuperacionTecnologica.Web.ViewModels.Equipos.EquipoListadoViewModel Listado, string Accion)
@using TPF.RecuperacionTecnologica.Web.ViewModels.Equipos
@{
    var orden = Model.Listado.Orden;

    var siguiente = orden == Model.Ascendente ? Model.Descendente : Model.Ascendente;

    var ariaSort = orden == Model.Ascendente ? "ascending" : orden == Model.Descendente ? "descending" : null;

    var icono = orden == Model.Ascendente ? "arrow-up" : orden == Model.Descendente ? "arrow-down" : "chevrons";
}
<th scope="col" aria-sort="@ariaSort">
    <a class="orden-link" asp-action="@Model.Accion"
       asp-route-Busqueda="@Model.Listado.Busqueda"
       asp-route-Estado="@Model.Listado.Estado"
       asp-route-Tipo="@Model.Listado.Tipo"
       asp-route-Orden="@siguiente">
        <span>@Model.Texto</span>
        <partial name="_Icon" model="@icono" />
    </a>
</th>
